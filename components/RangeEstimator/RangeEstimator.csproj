<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A distance-to-empty component: fuel level plus a recent economy it derives from fuel rate
    over speed. Built through the public SDK like the others (docs/writing-a-component.md); it
    draws a widget and a full-screen breakdown, so it targets net10.0-windows and references
    DashDeck.Abstractions.Wpf (ADR-0010), both Private=false so no copy of the shared contract
    lands beside the DLL.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RangeEstimator</AssemblyName>
    <RootNamespace>RangeEstimator</RootNamespace>
    <PluginDir>$(MSBuildProjectDirectory)\..\..\plugins\com.jpenner.rangeestimator</PluginDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DashDeck.Abstractions\DashDeck.Abstractions.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\..\src\DashDeck.Abstractions.Wpf\DashDeck.Abstractions.Wpf.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <Target Name="DeployToPlugin" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="component.json" DestinationFolder="$(PluginDir)" SkipUnchangedFiles="false" />
  </Target>

</Project>
