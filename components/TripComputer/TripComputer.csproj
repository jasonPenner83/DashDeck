<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A first-party component (ADR-0002), built through the public SDK on purpose: the
    contract has to be exercised before it ossifies (ADR-0008). It now draws a widget, so it
    references DashDeck.Abstractions.Wpf and targets net10.0-windows to match — the UI half of
    the split contract (ADR-0010). A genuinely headless component would reference only
    DashDeck.Abstractions and build anywhere; this one has a face.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>TripComputer</AssemblyName>
    <RootNamespace>TripComputer</RootNamespace>
    <!-- The plugin folder is the deploy target; the bin output is incidental. -->
    <PluginDir>$(MSBuildProjectDirectory)\..\..\plugins\com.jpenner.tripcomputer</PluginDir>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The shared contract (ADR-0002). Private=false so neither assembly is copied into the
      plugin folder: the host owns the single copy every component's types unify against, and
      a second copy beside the DLL is exactly what ComponentLoadContext exists to ignore.
    -->
    <ProjectReference Include="..\..\src\DashDeck.Abstractions\DashDeck.Abstractions.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\..\src\DashDeck.Abstractions.Wpf\DashDeck.Abstractions.Wpf.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!--
    Deploy the component into plugins/<id>/: its own DLL and its manifest. The manifest is
    source and lives here, tracked; plugins/ is a build output and is gitignored. So the
    component is reproducible from source alone — a fresh checkout has no plugins/<id>/ until
    this runs — and plugins/ never holds anything hand-edited.
  -->
  <Target Name="DeployToPlugin" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="component.json" DestinationFolder="$(PluginDir)" SkipUnchangedFiles="false" />
  </Target>

</Project>
