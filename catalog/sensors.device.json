// The sensor catalog: values the tablet can measure about the vehicle it is riding in.
//
// Data, not code, for the same reason the signal catalog is (ADR-0004) — and it carries one
// extra field that the signal catalog has no need for. "prefer" names the vehicle signal that
// SUPERSEDES this sensor: the moment that id appears in the signal catalog, the value comes
// from the truck and the tablet stands down, with no code change on either side. That is
// ADR-0016's rule written as data rather than as an if-statement.
//
// None of those signals exist yet. Every one of them is plausibly on the F-150's buses — the
// stability control system cannot work without lateral and longitudinal acceleration, and
// rollover mitigation implies attitude — but they are Ford messages behind PID discovery (R2)
// and the Gateway Module (R4, Q5). Guessing a PID would decode into a confidently wrong
// number that sits inside its own plausible range, which is the one failure this project
// refuses.
[
  {
    "id": "attitude.heading",
    "name": "Heading",
    "unit": "°",
    "source": "Compass",
    "channel": "Heading",
    "prefer": "vehicle.heading",
    "defaultRateHz": 8,
    "min": 0,
    "max": 360
  },
  {
    "id": "attitude.pitch",
    "name": "Pitch",
    "unit": "°",
    "source": "Inclinometer",
    "channel": "Pitch",
    "prefer": "vehicle.pitch",
    "defaultRateHz": 8,
    "needsMountReference": true,
    "min": -45,
    "max": 45
  },
  {
    "id": "attitude.roll",
    "name": "Roll",
    "unit": "°",
    "source": "Inclinometer",
    "channel": "Roll",
    "prefer": "vehicle.roll",
    "defaultRateHz": 8,
    "needsMountReference": true,
    "min": -45,
    "max": 45
  },
  {
    "id": "motion.lateralG",
    "name": "Lateral G",
    "unit": "g",
    "source": "Accelerometer",
    "channel": "Lateral",
    "prefer": "vehicle.lateralAccel",
    "defaultRateHz": 20,
    "needsMountReference": true,
    "min": -2,
    "max": 2
  },
  {
    "id": "motion.longitudinalG",
    "name": "Longitudinal G",
    "unit": "g",
    "source": "Accelerometer",
    "channel": "Longitudinal",
    "prefer": "vehicle.longitudinalAccel",
    "defaultRateHz": 20,
    "needsMountReference": true,
    "min": -2,
    "max": 2
  },

  // The phone's GPS (ADR-0027), over the network — the tablet has no GPS of its own. Ground
  // speed prefers vehicle.speed, so the truck's own wheel speed wins when it is plugged in and
  // the phone is the fallback. Latitude and longitude prefer vehicle signals that do not exist
  // yet (the F16/F19 convention): the day a Ford position PID is found, they come from the truck.
  {
    "id": "location.latitude",
    "name": "Latitude",
    "unit": "°",
    "source": "Gps",
    "channel": "Latitude",
    "prefer": "vehicle.latitude",
    "defaultRateHz": 2,
    "min": -90,
    "max": 90
  },
  {
    "id": "location.longitude",
    "name": "Longitude",
    "unit": "°",
    "source": "Gps",
    "channel": "Longitude",
    "prefer": "vehicle.longitude",
    "defaultRateHz": 2,
    "min": -180,
    "max": 180
  },
  {
    "id": "location.groundSpeed",
    "name": "GPS Speed",
    "unit": "km/h",
    "source": "Gps",
    "channel": "GroundSpeed",
    "prefer": "vehicle.speed",
    "defaultRateHz": 2,
    "min": 0,
    "max": 320
  }
]
