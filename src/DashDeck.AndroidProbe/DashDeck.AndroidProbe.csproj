<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DashDeck.Core\DashDeck.Core.csproj" />
  </ItemGroup>

  <!--
    gRPC to the Android Emulator (ADR-0075). The service definition is the emulator's own,
    vendored unchanged from google/android-emulator-webrtc (Apache-2.0); only a client is generated.
  -->
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Net.Client" Version="2.84.0" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\emulator_controller.proto" GrpcServices="Client" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>AndroidProbe</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DashDeck.AndroidProbe</RootNamespace>
  </PropertyGroup>

</Project>
