<Window x:Class="DashDeck.IdMatcher.SignalEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DashDeck signal" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" FontSize="13" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="Intro" Style="{StaticResource Hint}" Margin="0,0,0,12" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.Resources>
                <Style TargetType="TextBlock" BasedOn="{x:Null}">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Margin" Value="0,0,8,6" />
                </Style>
                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                    <Setter Property="Margin" Value="0,0,0,6" />
                </Style>
            </Grid.Resources>

            <TextBlock Grid.Row="0" Text="Id" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="IdBox" FontFamily="{StaticResource Mono}" />
            <TextBlock Grid.Row="1" Text="Name" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="NameBox" />
            <TextBlock Grid.Row="2" Text="Category" />
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="CategoryBox" />

            <TextBlock Grid.Row="3" Text="Bus" />
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                <RadioButton x:Name="HsRadio" Content="HS (main)" Margin="0,0,16,0" IsChecked="True" />
                <RadioButton x:Name="P311Radio" Content="Pins 3/11" />
            </StackPanel>

            <TextBlock Grid.Row="4" Text="Module · mode · PID" />
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBox x:Name="ModuleBox" Width="70" Margin="0" FontFamily="{StaticResource Mono}" ToolTip="Hex, e.g. 7E0. Empty: the broadcast (standard mode 01)." />
                <TextBox x:Name="ModeBox" Width="50" Margin="8,0,0,0" FontFamily="{StaticResource Mono}" ToolTip="Hex: 01 standard, 22 Ford" />
                <TextBox x:Name="PidBox" Width="80" Margin="8,0,0,0" FontFamily="{StaticResource Mono}" ToolTip="Hex, e.g. 1E1C" />
            </StackPanel>

            <TextBlock Grid.Row="5" Text="Bytes" />
            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="from" Margin="0,0,6,0" />
                <TextBox x:Name="ByteOffsetBox" Width="40" Margin="0" ToolTip="0 is the first byte after the PID (A)" />
                <TextBlock Text="length" Margin="12,0,6,0" />
                <ComboBox x:Name="LengthBox" Width="50" SelectedIndex="0">
                    <ComboBoxItem Content="1" /><ComboBoxItem Content="2" /><ComboBoxItem Content="4" />
                </ComboBox>
                <CheckBox x:Name="SignedBox" Content="signed" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="6" Text="Value = raw ×" />
            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBox x:Name="ScaleBox" Width="90" Margin="0" FontFamily="{StaticResource Mono}" />
                <TextBlock Text="+" Margin="8,0,8,0" />
                <TextBox x:Name="OffsetBox" Width="80" Margin="0" FontFamily="{StaticResource Mono}" />
                <TextBlock Text="unit" Margin="12,0,6,0" />
                <TextBox x:Name="UnitBox" Width="70" Margin="0" />
            </StackPanel>

            <TextBlock Grid.Row="7" Text="Range" />
            <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBox x:Name="MinBox" Width="80" Margin="0" ToolTip="Optional" />
                <TextBlock Text="to" Margin="8,0,8,0" />
                <TextBox x:Name="MaxBox" Width="80" Margin="0" ToolTip="Optional" />
            </StackPanel>

            <TextBlock Grid.Row="8" Text="Readings a second" />
            <TextBox Grid.Row="8" Grid.Column="1" x:Name="RateBox" Width="80" HorizontalAlignment="Left" />
        </Grid>

        <TextBlock x:Name="Problem" Foreground="#B00020" TextWrapping="Wrap" Margin="0,6,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save" IsDefault="True" Click="OnSave" MinWidth="90" FontWeight="SemiBold" />
            <Button Content="Cancel" IsCancel="True" MinWidth="90" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
