<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DashDeck.Abstractions\DashDeck.Abstractions.csproj" />
    <ProjectReference Include="..\DashDeck.Abstractions.Wpf\DashDeck.Abstractions.Wpf.csproj" />
    <ProjectReference Include="..\DashDeck.Core\DashDeck.Core.csproj" />
    <ProjectReference Include="..\DashDeck.Simulator\DashDeck.Simulator.csproj" />
    <ProjectReference Include="..\DashDeck.Vehicle\DashDeck.Vehicle.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The signal catalog is data, not code (ADR-0004), so it is not embedded — new signals
      are JSON, never a recompile. It does have to travel with the binary though: running
      from the repo, VehicleStack.FindCatalog walks up and finds it, but a published folder
      has nothing above it to walk to.
    -->
    <Content Include="..\..\catalog\**\*.json" Link="catalog\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- MVVM in the shell only (ADR-0011). This must never reach DashDeck.Abstractions,
         which ADR-0002 keeps dependency-free because it is shared across load contexts. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
    <!-- The phone's GPS over Bluetooth (ADR-0027): a paired phone appears as a virtual COM
         port using Windows' in-box serial-over-Bluetooth driver, so this reads NMEA from it.
         No driver install, so it does not touch C1's two-driver limit. -->
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      Windows 10 2004 rather than plain net10.0-windows, purely for one thing: the WinRT
      projection that reaches the tablet's magnetometer, which is the compass' fallback when
      the truck cannot supply a heading. The Surface runs Windows 11, so the floor costs
      nothing here, and it is the Host alone — the engine and its tests still target plain
      net10.0 and still build anywhere (ADR-0010).
    -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!--
      Directory.Build.props turns on InvariantGlobalization for the whole solution, which is
      right for the headless engine: smaller, deterministic, no ICU. WPF cannot run under it.
      Its font stack builds a CultureInfo("en") while measuring the very first TextBlock and
      throws CultureNotFoundException, so the window dies during Show() before anything is
      drawn. Overridden here only, so the engine keeps the property and the shell can render.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- Declares PerMonitorV2 DPI awareness. The tablet runs at 200%; see app.manifest. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- The component host's fault containment is internal, and testing it directly with a
         fake component is far cheaper than staging a faulting assembly on disk. -->
    <InternalsVisibleTo Include="DashDeck.Host.Tests" />
  </ItemGroup>

</Project>
