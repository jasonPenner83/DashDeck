<Window x:Class="DashDeck.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DashDeck.Host.Converters"
        xmlns:views="clr-namespace:DashDeck.Host.Views"
        xmlns:warn="clr-namespace:DashDeck.Host.Warnings"
        Title="DashDeck"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Background="{DynamicResource CanvasBrush}"
        BorderThickness="0"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <conv:QualityToBrushConverter x:Key="QualityBrush" />
        <conv:QualityToLabelConverter x:Key="QualityLabel" />
        <conv:QualityToValueBrushConverter x:Key="ValueBrush" />
        <conv:BandsToGridLengthConverter x:Key="Bands" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToBandLengthConverter x:Key="BandLength" />
    </Window.Resources>

    <!--
        The shell is authored at exactly the Pro 7's portrait size and scaled to whatever
        window it lands in. On the tablet, full-screen, that scale is 1:1 and the numbers in
        B2 are literal. On a landscape dev screen it simply shrinks, which is a P0.5
        convenience rather than the final arrangement.
    -->
    <Viewbox Stretch="Uniform">
        <Grid x:Name="DesignSurface" Width="912" Height="1368" Background="{DynamicResource CanvasBrush}">
            <Grid.RowDefinitions>
                <!-- BandGrid is the authority: 90 + six 195 bands + 108 = 1368. -->
                <RowDefinition Height="90" />
                <RowDefinition Height="1170" />
                <RowDefinition Height="108" />
            </Grid.RowDefinitions>

            <!-- Status strip -->
            <Border Grid.Row="0"
                    Background="{DynamicResource StripBackgroundBrush}"
                    BorderBrush="{DynamicResource HairlineBrush}"
                    BorderThickness="0,0,0,1">
                <!--
                    A quick-info bar, not a diagnostics readout. The source label, the drive
                    name and the request rate all moved to Settings: they answer questions a
                    developer asks and nobody asks while driving. What is left is what you
                    glance at — the weather, the time, and the badge that stops synthetic
                    numbers being mistaken for real ones.
                -->
                <Grid Margin="31,0,16,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock FontFamily="{DynamicResource UiFont}"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextHighBrush}"
                                   Text="{Binding OutsideText}" />
                        <TextBlock Style="{StaticResource StatusText}"
                                   Margin="10,0,0,0"
                                   Foreground="{DynamicResource TextMidBrush}"
                                   Text="{Binding ConditionText}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- The stage keeps running behind a full-screen view (Q17), so audio can
                             play with nothing on screen to say so (F22/ADR-0025). This pill appears
                             only then, names what is on, and taps back to it. Hidden the moment the
                             stage is visible again, so it costs nothing in the ordinary case. -->
                        <Button Margin="0,0,18,0"
                                VerticalAlignment="Center"
                                Cursor="Hand"
                                ToolTip="Back to the stage"
                                Command="{Binding ReturnToStageCommand}"
                                Visibility="{Binding StageRunningButHidden, Converter={StaticResource BoolToVis}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Pill" CornerRadius="999" Padding="11,4"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource AccentBrush}"
                                            BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="▶"
                                                       FontFamily="{DynamicResource UiFont}" FontSize="10"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                            <TextBlock Text="{Binding HiddenOccupantName}" Margin="7,0,0,0"
                                                       FontFamily="{DynamicResource MonoFont}" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextMidBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Pill" Property="Background"
                                                    Value="{DynamicResource HairlineBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Never removed while the data is simulated, however tight the bar
                             gets: synthetic numbers that could be mistaken for real ones are
                             the one thing this project will not ship. It is bound rather than
                             always-on now that a real adapter is possible — a badge reading
                             SIM over live data is worse than no badge, because it teaches you
                             to ignore it. -->
                        <Border CornerRadius="999"
                                Padding="10,4,10,4"
                                VerticalAlignment="Center"
                                BorderThickness="1"
                                BorderBrush="#8DA6FF"
                                Visibility="{Binding IsSimulated, Converter={StaticResource BoolToVis}}">
                            <TextBlock FontFamily="{DynamicResource MonoFont}"
                                       FontSize="11"
                                       Foreground="#8DA6FF"
                                       Text="SIM" />
                        </Border>

                        <TextBlock Margin="18,0,0,0"
                                   FontFamily="{DynamicResource UiFont}"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextHighBrush}"
                                   Text="{Binding ClockText}" />

                        <!-- The overflow menu. Replaces a hold gesture that could never have
                             worked on a touch screen. -->
                        <Button Margin="14,0,0,0"
                                Style="{StaticResource KebabButton}"
                                Command="{Binding ToggleMenuCommand}"
                                ToolTip="More" />
                    </StackPanel>

                    <!--
                        Adapter-lost banner. Overlays the quick-info content, because when the
                        link is gone that IS the thing to glance at, and the weather can wait.
                        The amber is the Stale colour (#E0B23C, QualityPalette.Stale) on
                        purpose: the widgets go this colour when readings stop, and the banner
                        naming the cause matches them rather than inventing a fifth signal
                        colour. The kebab stays reachable to its right. Hidden entirely while
                        connected, so it costs nothing in the ordinary case.
                    -->
                    <!-- Opaque underneath the amber wash, so what it covers does not show through it. -->
                    <Border CornerRadius="6"
                            Background="{DynamicResource StripBackgroundBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsAdapterLost, Converter={StaticResource BoolToVis}}">
                        <Border CornerRadius="6"
                                Background="#22E0B23C"
                                BorderBrush="#E0B23C"
                                BorderThickness="1"
                                Padding="12,4">
                            <TextBlock FontFamily="{DynamicResource MonoFont}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#E0B23C"
                                       VerticalAlignment="Center"
                                       MaxWidth="700"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding LinkStatusText}" />
                        </Border>
                    </Border>

                    <!-- A configured adapter that did not come up. Falling back to the
                         simulator keeps the dash alive on a desk, but it must never be
                         silent: without this the app knew why and showed nothing, which is
                         indistinguishable from the setting not having worked. -->
                    <!-- Opaque underneath the amber wash, so what it covers does not show through it. -->
                    <Border CornerRadius="6"
                            Background="{DynamicResource StripBackgroundBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasAdapterFallback, Converter={StaticResource BoolToVis}}">
                        <Border CornerRadius="6"
                                Background="#22E0B23C"
                                BorderBrush="#E0B23C"
                                BorderThickness="1"
                                Padding="12,4">
                            <TextBlock FontFamily="{DynamicResource MonoFont}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#E0B23C"
                                       VerticalAlignment="Center"
                                       MaxWidth="700"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding AdapterFallbackText}" />
                        </Border>
                    </Border>
                </Grid>
            </Border>

            <!--
                A warning while moving (ADR-0055): one strip across the top, over the status strip,
                with the light, one word and a big DISMISS — nothing to read at speed. It lives in the
                strip's row rather than over the stage because a stage occupant's child window (video,
                web, a program) draws over any WPF content there. Red for stop, amber for caution:
                fixed colours, like the quality colours, so no theme can quieten them.
            -->
            <Border Grid.Row="0"
                    DataContext="{Binding Warnings}"
                    Visibility="{Binding ShowBanner, Converter={StaticResource BoolToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#FF2A1C00" />
                        <Setter Property="BorderBrush" Value="#FFB020" />
                        <Setter Property="BorderThickness" Value="0,0,0,3" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStop}" Value="True">
                                <Setter Property="Background" Value="#FF2E0A08" />
                                <Setter Property="BorderBrush" Value="#FF453A" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel Margin="24,0,10,0" LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource StageLauncherButton}"
                            Width="230" Height="70" VerticalAlignment="Center"
                            Command="{Binding DismissCommand}">
                        <TextBlock Text="DISMISS" FontFamily="{DynamicResource MonoFont}" FontSize="24" FontWeight="Bold"
                                   Foreground="White" />
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="54" Height="54">
                            <Canvas Width="24" Height="24">
                                <Path Data="{Binding IconData}" Fill="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=Border}}" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Margin="20,0,0,0" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource UiFont}" FontSize="40" FontWeight="Bold"
                                   Foreground="White"
                                   Text="{Binding BannerWord}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- The six bands -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <!-- The stage takes what its occupant asked for; the widgets take the
                         rest. Six bands, negotiated at runtime rather than hard-coded. -->
                    <RowDefinition Height="{Binding StageBands, Converter={StaticResource Bands}}" />
                    <RowDefinition Height="{Binding WidgetBands, Converter={StaticResource Bands}}" />
                </Grid.RowDefinitions>

                <!-- The stage. Its occupant's view when there is one, an honest empty state
                     when there is not (Q13). -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource HairlineBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!--
                                The stage bar. A real row rather than an overlay, because
                                every occupant so far renders into a child window — LibVLC's
                                video surface and WebView2 both — and a child window draws
                                over all WPF content whatever the z-order says. A chip
                                floating on top of the stage is invisible and untappable the
                                moment anything loads, which made a loaded stage impossible
                                to change. Sitting beside the occupant instead of over it is
                                the only arrangement that survives.
                            -->
                            <RowDefinition Height="*" />
                            <RowDefinition Height="72" />
                        </Grid.RowDefinitions>

                        <!-- The launcher. A row of app buttons plus a grid button for the
                             rest, sized to be hit from the driver's seat. -->
						<Border Grid.Row="1" Background="{DynamicResource CanvasBrush}"
                            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0">
                            <DockPanel Margin="14,0,14,0" LastChildFill="False">

                                <Button DockPanel.Dock="Right"
                                        Command="{Binding ToggleStagePickerCommand}"
                                        Style="{StaticResource StageLauncherButton}"
                                        Width="58"
                                        ToolTip="All apps">
                                    <!-- Nine dots: every app, not just the ones that fit. -->
                                    <UniformGrid Columns="3" Rows="3" Width="20" Height="20"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse Width="4" Height="4" Margin="1" Fill="{DynamicResource TextMidBrush}" />
                                        <Ellipse Width="4" Height="4" Margin="1" Fill="{DynamicResource TextMidBrush}" />
                                        <Ellipse Width="4" Height="4" Margin="1" Fill="{DynamicResource TextMidBrush}" />
                                        <Ellipse Width="4" Height="4" Margin="1" Fill="{DynamicResource TextMidBrush}" />
                                        <Ellipse Width="4" Height="4" Margin="1" Fill="{DynamicResource TextMidBrush}" />
                                        <Ellipse Width="4" Height="4" Margin="1" Fill="{DynamicResource TextMidBrush}" />
                                        <Ellipse Width="4" Height="4" Margin="1" Fill="{DynamicResource TextMidBrush}" />
                                        <Ellipse Width="4" Height="4" Margin="1" Fill="{DynamicResource TextMidBrush}" />
                                        <Ellipse Width="4" Height="4" Margin="1" Fill="{DynamicResource TextMidBrush}" />
                                    </UniformGrid>
                                </Button>

                                <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding QuickStageOptions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource StageLauncherButton}"
                                                    Command="{Binding DataContext.ChooseStageCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding Name}"
                                                           FontFamily="{DynamicResource MonoFont}"
                                                           FontSize="13"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </DockPanel>
                        </Border>

                        <!-- The audio/video source, in its own host behind the screen (ADR-0026).
                             It keeps this host for its whole life, so switching to a screen only
                             collapses it — never reparents it — and it keeps playing. Only ever
                             visible when no screen is over it, so two child windows never draw at
                             once. -->
                        <ContentControl Grid.Row="0"
                                        Content="{Binding SourceContent}"
                                        Visibility="{Binding IsSourceVisible, Converter={StaticResource BoolToVis}}" />

                        <ContentControl Grid.Row="0"
                                        Content="{Binding StageContent}"
                                        Visibility="{Binding IsOccupantVisible, Converter={StaticResource BoolToVis}}" />

                        <StackPanel Grid.Row="0"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding StageIsEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Margin="0,14,0,0"
                                   FontFamily="{DynamicResource UiFont}"
                                   FontSize="24"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextLowBrush}"
                                   Text="No stage occupant" />
                        <TextBlock Margin="0,10,0,0"
                                   FontFamily="{DynamicResource MonoFont}"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFaintBrush}"
                                   Text="pick an app below" />
                        </StackPanel>

                        <!-- The picker. Fills the stage, because that is where the thing
                             you are choosing will appear. Big targets, one tap, no
                             navigation to get back out of. -->
                        <!-- Fully opaque, not a scrim. A translucent panel over the empty
                             state reads as muddy rather than layered, and legibility wins
                             in a vehicle. -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource CanvasBrush}"
                                Visibility="{Binding IsStagePickerOpen, Converter={StaticResource BoolToVis}}">
                            <StackPanel VerticalAlignment="Center" Margin="31,0,31,0">
                                <TextBlock Style="{StaticResource CaptionText}"
                                           Margin="0,0,0,22"
                                           Text="ON THE STAGE" />


                                <!--
                                    Three columns, and it scrolls. Two columns clipped the
                                    ninth option off the bottom of the stage the moment
                                    Spotify and Apple Music were added — a picker that hides
                                    the thing you are looking for is worse than no picker.
                                    Three fits twelve without scrolling; the ScrollViewer is
                                    for the thirteenth.
                                -->
                                <!-- SCREENS / WEB / APPS, each a header over a three-across grid.
                                     Stacked explicitly (an outer section list, an inner card grid)
                                     rather than with a grouped view, whose GroupStyle transposed
                                     the sections into side-by-side columns. -->
                                <ItemsControl ItemsSource="{Binding StageGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,6">
                                                <TextBlock Style="{StaticResource CaptionText}"
                                                           Margin="0,2,0,12"
                                                           Text="{Binding Header}" />

                                                <ItemsControl ItemsSource="{Binding Options}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="3" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Height="104" Margin="0,0,20,16"
                                                                    Command="{Binding DataContext.ChooseStageCommand,
                                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    IsEnabled="{Binding IsAvailable}"
                                                                    Cursor="Hand">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="Chrome"
                                                                                Background="{DynamicResource SurfaceBrush}"
                                                                                BorderBrush="{DynamicResource HairlineBrush}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="18"
                                                                                Padding="24,0,24,0">
                                                                            <ContentPresenter VerticalAlignment="Center" />
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsEnabled" Value="False">
                                                                                <Setter TargetName="Chrome" Property="Background" Value="Transparent" />
                                                                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                                                                            </Trigger>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Chrome" Property="BorderBrush"
                                                                                        Value="{DynamicResource AccentBrush}" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                                <StackPanel>
                                                                    <TextBlock FontFamily="{DynamicResource UiFont}"
                                                                               FontSize="24" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource TextHighBrush}"
                                                                               Text="{Binding Name}" />
                                                                    <TextBlock Margin="0,6,0,0"
                                                                               Style="{StaticResource CaptionText}"
                                                                               Text="{Binding Detail}" />
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Settings takes the whole lower region. The stage keeps running above
                     it, which is the point of the stage being a layer (B2). -->
                <ContentControl Grid.Row="1"
                                Visibility="{Binding IsSettingsActive, Converter={StaticResource BoolToVis}}">
                    <views:SettingsView DataContext="{Binding Settings}" />
                </ContentControl>

                <!-- Editing a card is a full-screen view like any other (Q17): it takes all
                     six bands and the stage keeps running underneath it. -->
                <ContentControl Grid.Row="1"
                                Visibility="{Binding IsCardEditorOpen, Converter={StaticResource BoolToVis}}">
                    <views:CardEditorView DataContext="{Binding Dashboard.Editor}" />
                </ContentControl>

                <!-- A component's full-screen detail (ADR-0023), opened by tapping a component
                     card. Same rule as the others: it covers the widget region, the stage runs
                     underneath, and the back bar is the way out. The host draws this chrome; the
                     component supplies only what sits below the bar. -->
                <Grid Grid.Row="1"
                      Background="{DynamicResource CanvasBrush}"
                      Visibility="{Binding IsComponentDetailOpen, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="31,24,31,0">
                        <Button DockPanel.Dock="Left"
                                Style="{StaticResource OptionChipButton}"
                                Content="‹ BACK"
                                Command="{Binding Dashboard.CloseComponentDetailCommand}" />
                        <TextBlock Margin="18,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource StatusText}"
                                   Text="{Binding Dashboard.ComponentDetailTitle}" />
                    </DockPanel>

                    <ContentControl Grid.Row="1" Content="{Binding Dashboard.ComponentDetail}" />
                </Grid>

                <!-- The climate panel (ADR-0040): a layout file drawn where the cards are,
                     made only while CLIMATE is chosen. Read only — it shows, never sets. -->
                <ContentControl Grid.Row="1"
                                Content="{Binding ClimateContent}"
                                Visibility="{Binding IsClimateVisible, Converter={StaticResource BoolToVis}}" />

                <!-- Drawn in the nav because the nav is the destination list (B3), but
                     nothing is behind them yet. Saying so beats a blank region. -->
                <StackPanel Grid.Row="1"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsDestinationUnbuilt, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ActiveDestination}"
                               HorizontalAlignment="Center"
                               FontFamily="{DynamicResource UiFont}"
                               FontSize="24"
                               Foreground="{DynamicResource TextLowBrush}" />
                    <TextBlock Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               Style="{StaticResource MicroText}"
                               Text="not built yet" />
                </StackPanel>

                <!-- The console (ADR-0041): a layout file drawn where the cards used to be, made only
                     while DASH is chosen. The cards are on the stage now, behind CARDS. -->
                <ContentControl Grid.Row="1"
                                Content="{Binding ConsoleContent}"
                                Visibility="{Binding IsDashVisible, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <!-- Navigation. Switches only what sits below the stage (B2/B3): the
                 stage keeps running, so choosing Settings does not stop the music. -->
            <Border Grid.Row="2"
                    Background="{DynamicResource NavBackgroundBrush}"
                    BorderBrush="{DynamicResource HairlineBrush}"
                    BorderThickness="0,1,0,0"
                    Visibility="{Binding IsNavVisible, Converter={StaticResource BoolToVis}}">
                <!--
                    Fixed 130-wide cells, centred, rather than a UniformGrid stretching four
                    buttons across the full 912. Stretched, each destination was 228 × 168 —
                    a target about the size of a hand, which looked deliberate on a desk and
                    absurd in the truck. At 130 the strip holds seven, so B3's overflow
                    problem starts at about seven destinations instead of about five, and
                    adding one does not resize the others.
                -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                    <Button Command="{Binding NavigateCommand}" CommandParameter="DASH" Cursor="Hand" Width="130">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Cell" Background="Transparent"
                                        BorderBrush="Transparent" BorderThickness="0,3,0,0">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Path x:Name="Glyph" Data="M3,3 H21 V12 H3 Z M3,15 H10 V21 H3 Z M14,15 H21 V21 H14 Z"
                                              Stroke="{DynamicResource NavTextBrush}" StrokeThickness="1.75"
                                              Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="Label" Margin="0,7,0,0" HorizontalAlignment="Center"
                                                   FontFamily="{DynamicResource MonoFont}" FontSize="12"
                                                   Foreground="{DynamicResource NavTextBrush}" Text="DASH" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsDashActive}" Value="True">
                                        <Setter TargetName="Cell" Property="Background" Value="{DynamicResource AccentWashBrush}" />
                                        <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource SelectedTextBrush}" />
                                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource SelectedTextBrush}" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Command="{Binding NavigateCommand}" CommandParameter="STEREO" Cursor="Hand" Width="130">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Cell" Background="Transparent"
                                        BorderBrush="Transparent" BorderThickness="0,3,0,0">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Path x:Name="Glyph" Data="M12,3 A9,9 0 1 1 11.99,3 Z M12,9.5 A2.5,2.5 0 1 1 11.99,9.5 Z"
                                              Stroke="{DynamicResource NavTextBrush}" StrokeThickness="1.75"
                                              Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="Label" Margin="0,7,0,0" HorizontalAlignment="Center"
                                                   FontFamily="{DynamicResource MonoFont}" FontSize="12"
                                                   Foreground="{DynamicResource NavTextBrush}" Text="STEREO" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsStereoActive}" Value="True">
                                        <Setter TargetName="Cell" Property="Background" Value="{DynamicResource AccentWashBrush}" />
                                        <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource SelectedTextBrush}" />
                                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource SelectedTextBrush}" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Command="{Binding NavigateCommand}" CommandParameter="CLIMATE" Cursor="Hand" Width="130">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Cell" Background="Transparent"
                                        BorderBrush="Transparent" BorderThickness="0,3,0,0">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Path x:Name="Glyph" Data="M3,8 C5,6 7,6 9,8 C11,10 13,10 15,8 C17,6 19,6 21,8 M3,13 C5,11 7,11 9,13 C11,15 13,15 15,13 C17,11 19,11 21,13 M3,18 C5,16 7,16 9,18 C11,20 13,20 15,18 C17,16 19,16 21,18"
                                              Stroke="{DynamicResource NavTextBrush}" StrokeThickness="1.75"
                                              Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="Label" Margin="0,7,0,0" HorizontalAlignment="Center"
                                                   FontFamily="{DynamicResource MonoFont}" FontSize="12"
                                                   Foreground="{DynamicResource NavTextBrush}" Text="CLIMATE" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsClimateActive}" Value="True">
                                        <Setter TargetName="Cell" Property="Background" Value="{DynamicResource AccentWashBrush}" />
                                        <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource SelectedTextBrush}" />
                                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource SelectedTextBrush}" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>


                </StackPanel>
            </Border>

            <!--
                The edit toolbar takes the nav band while the dash is being rearranged.
                It replaces the destinations rather than sitting somewhere else, for two
                reasons: this is the only band reachable from the driver's seat, so the
                controls in use belong here — and navigating away mid-edit was never going
                to be useful. The dash region above stays pixel-identical, so what you are
                arranging is exactly what you will be reading.
            -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource HairlineBrush}"
                    BorderThickness="0,1,0,0"
                    Visibility="{Binding IsDashEditing, Converter={StaticResource BoolToVis}}">
                <Grid Margin="31,0,31,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource StageLauncherButton}"
                                Command="{Binding Dashboard.AddCardCommand}">
                            <TextBlock FontFamily="{DynamicResource MonoFont}" FontSize="15" Text="+ ADD CARD" />
                        </Button>

                        <Button Style="{StaticResource StageLauncherButton}"
                                Command="{Binding Dashboard.ResetToDefaultsCommand}">
                            <TextBlock FontFamily="{DynamicResource MonoFont}" FontSize="15" Text="RESET" />
                        </Button>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                IsHitTestVisible="False">
                        <TextBlock HorizontalAlignment="Center"
                                   Style="{StaticResource CaptionText}"
                                   Text="EDITING THE DASH" />
                        <TextBlock HorizontalAlignment="Center"
                                   Margin="0,4,0,0"
                                   Style="{StaticResource MicroText}"
                                   Text="tap a card to change it · ‹ › to move it · ✕ to remove it" />
                    </StackPanel>

                    <Button Style="{StaticResource StageLauncherButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="10,0,0,0"
                            Command="{Binding Dashboard.ToggleEditCommand}">
                        <TextBlock FontFamily="{DynamicResource MonoFont}" FontSize="15" Text="DONE" />
                    </Button>
                </Grid>
            </Border>

            <!--
                The overflow menu. Spans every row deliberately: it is modal, and a scrim that
                only covered part of the screen would leave the rest tappable underneath.
            -->
            <Grid Grid.Row="0" Grid.RowSpan="3"
                  Visibility="{Binding IsMenuOpen, Converter={StaticResource BoolToVis}}">

                <!-- Tap anywhere off the menu to dismiss it. -->
                <Button Background="#C0000000"
                        BorderThickness="0"
                        Command="{Binding ToggleMenuCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" />
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Border Width="420"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,90,16,0"
                        Padding="18"
                        CornerRadius="18"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource HairlineStrongBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <!--
                            What the current occupant can be told to do. First, because it is
                            the contextual half of the menu and the reason the stage got its
                            band back (ADR-0022).
                        -->
                        <ItemsControl ItemsSource="{Binding StageActions}"
                                      Visibility="{Binding HasStageActions, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource MenuItemButton}"
                                            Command="{Binding DataContext.RunStageActionCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock FontFamily="{DynamicResource MonoFont}"
                                                   FontSize="16"
                                                   Text="{Binding Caption}" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Height="1"
                                Margin="0,4,0,14"
                                Background="{DynamicResource HairlineStrongBrush}"
                                Visibility="{Binding HasStageActions, Converter={StaticResource BoolToVis}}" />

                        <Button Style="{StaticResource MenuItemButton}"
                                Command="{Binding EditDashCommand}">
                            <TextBlock FontFamily="{DynamicResource MonoFont}" FontSize="16" Text="MODIFY WIDGETS" />
                        </Button>

                        <Button Style="{StaticResource MenuItemButton}"
                                Command="{Binding OpenSettingsCommand}">
                            <TextBlock FontFamily="{DynamicResource MonoFont}" FontSize="16" Text="SETTINGS" />
                        </Button>

                        <!-- Quits DashDeck. Two taps, because on the truck this is the only way
                             out (no keyboard, so no Escape) and one stray tap must not end the
                             dash. Tapping outside the menu is how to dismiss it. -->
                        <Button Style="{StaticResource MenuItemButton}"
                                Margin="0"
                                Command="{Binding CloseAppCommand}">
                            <TextBlock FontFamily="{DynamicResource MonoFont}" FontSize="16" Text="{Binding CloseCaption}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextMidBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCloseArmed}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!--
                A warning while stopped (ADR-0055): the whole screen, because it is the moment to read
                it. The stage occupant is collapsed underneath (its child window would draw over this)
                and keeps running. DISMISS keeps it quiet until the light goes off and comes back, or a
                new code is stored; the console's light stays lit either way.
            -->
            <Grid Grid.Row="0" Grid.RowSpan="3"
                  DataContext="{Binding Warnings}"
                  Visibility="{Binding ShowWindow, Converter={StaticResource BoolToVis}}">
                <Border Background="#E6000000" />
                <Border Margin="28,120,28,120"
                        Padding="34,30"
                        CornerRadius="22"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderThickness="3">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="#FFB020" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStop}" Value="True">
                                    <Setter Property="BorderBrush" Value="#FF453A" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                            <Viewbox Width="76" Height="76">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{Binding IconData}"
                                          Fill="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=Border}}" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Margin="22,0,0,0" VerticalAlignment="Center"
                                       FontFamily="{DynamicResource UiFont}" FontSize="44" FontWeight="Bold"
                                       Foreground="{DynamicResource TextHighBrush}"
                                       Text="{Binding Title}" />
                        </StackPanel>

                        <Button DockPanel.Dock="Bottom"
                                Style="{StaticResource StageLauncherButton}"
                                Height="96" Margin="0,22,0,0"
                                Command="{Binding DismissCommand}">
                            <TextBlock Text="DISMISS" FontFamily="{DynamicResource MonoFont}" FontSize="28" FontWeight="Bold" />
                        </Button>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,22,0,0" PanningMode="VerticalOnly">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap"
                                           FontFamily="{DynamicResource UiFont}" FontSize="24"
                                           Foreground="{DynamicResource TextHighBrush}"
                                           Text="{Binding Advice}" />

                                <StackPanel Margin="0,28,0,0"
                                            Visibility="{Binding ShowsCodes, Converter={StaticResource BoolToVis}}">
                                    <views:TroubleCodesPanel />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

        </Grid>
    </Viewbox>
</Window>
