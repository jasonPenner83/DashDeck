<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The design system ADR-0001 leaves to us, as named tokens rather than literals.
        B1 turns these into something the user can tweak, which only works if every colour
        in the shell comes from here. No hard-coded brushes below this file.
    -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="CanvasBrush" Color="#0D0C0B" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#191816" />
    <SolidColorBrush x:Key="RaisedBrush" Color="#211F1C" />
    <SolidColorBrush x:Key="HairlineBrush" Color="#2C2925" />
    <SolidColorBrush x:Key="HairlineStrongBrush" Color="#3A3630" />

    <!-- Text ramp -->
    <SolidColorBrush x:Key="TextHighBrush" Color="#F4F1EB" />
    <SolidColorBrush x:Key="TextMidBrush" Color="#A5A096" />
    <SolidColorBrush x:Key="TextLowBrush" Color="#6B665E" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="#4A453E" />

    <!-- The one accent. Deliberately not any of the four quality colours. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF7A1A" />
    <SolidColorBrush x:Key="AccentWashBrush" Color="#14FF7A1A" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#140A02" />

    <!--
        Archivo and IBM Plex Mono are both OFL and get embedded in the packaged build.
        Until then WPF falls back to the second name, which is why it is listed.
    -->
    <FontFamily x:Key="UiFont">Archivo, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">IBM Plex Mono, Consolas</FontFamily>

    <!-- Small uppercase caption. WPF has no letter-spacing, so these read tighter than the
         mockups until a custom run is written; tracked as a P0.5 polish item. -->
    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextLowBrush}" />
    </Style>

    <Style x:Key="MicroText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
    </Style>

    <Style x:Key="ValueText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="50" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextHighBrush}" />
    </Style>

    <Style x:Key="UnitText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Foreground" Value="{StaticResource TextMidBrush}" />
    </Style>

    <Style x:Key="StatusText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource TextMidBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
        A button in the stage launcher. 56 tall inside a 72 bar, which keeps it above the
        touch-target floor while leaving the bar itself thin enough not to eat the stage.
        The current occupant's button is lit with the accent so the row says what is on.
    -->
    <Style x:Key="StageLauncherButton" TargetType="Button">
        <Setter Property="Height" Value="56" />
        <Setter Property="MinWidth" Value="104" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="Foreground" Value="{StaticResource TextMidBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="Transparent"
                            BorderBrush="{StaticResource HairlineStrongBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="16,0,16,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentWashBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A widget: one band tall, one column wide (270 x 165 on the Pro 7). -->
    <Style x:Key="WidgetCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="18,16,18,16" />
    </Style>

</ResourceDictionary>
