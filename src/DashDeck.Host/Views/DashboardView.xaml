<UserControl x:Class="DashDeck.Host.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DashDeck.Host.Converters"
             xmlns:dash="clr-namespace:DashDeck.Host.Dash"
             xmlns:host="clr-namespace:DashDeck.Host"
             xmlns:vm="clr-namespace:DashDeck.Host.ViewModels"
             Width="912">

    <UserControl.Resources>
        <conv:EqualityConverter x:Key="Equality" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!--
            A card. One row tall; one or two columns wide, which the packer decided and the
            slot carries. Everything that changes in edit mode is an overlay on top of the
            same card rather than a second template: what you are rearranging has to look
            like what you will be reading.
        -->
        <DataTemplate DataType="{x:Type vm:WidgetCardViewModel}">
            <Grid Width="{Binding Width}" Height="{x:Static host:BandGrid.WidgetRowHeight}">
                <ContentPresenter Content="{Binding}"
                                  ContentTemplate="{StaticResource WidgetCardFace}" />

                <!-- Edit affordances. Hit targets are deliberately larger than they look. -->
                <Grid Visibility="{Binding DataContext.IsEditing,
                                           RelativeSource={RelativeSource AncestorType=UserControl},
                                           Converter={StaticResource BoolToVis}}">

                    <!--
                        A scrim over the card face. Two jobs: it makes edit mode
                        unmistakable at a glance, and it settles the collision between the
                        reorder chevrons and the card's own footer line — the controls have
                        to sit on the card because the gutters are 20 pixels wide, so the
                        card underneath them is dimmed instead of being fought with.
                    -->
                    <Border Background="#B0000000" CornerRadius="14" IsHitTestVisible="False" />

                    <!-- The whole card opens its editor. -->
                    <Button Style="{StaticResource CardSurfaceButton}"
                            Command="{Binding DataContext.OpenEditorCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />

                    <Button Style="{StaticResource CardBadgeButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,-10,-10,0"
                            Content="✕"
                            Command="{Binding DataContext.RemoveCardCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                Margin="-10,0,0,-10">
                        <Button Style="{StaticResource CardBadgeButton}"
                                Content="‹"
                                Command="{Binding DataContext.MoveEarlierCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                        <Button Style="{StaticResource CardBadgeButton}"
                                Margin="8,0,0,0"
                                Content="›"
                                Command="{Binding DataContext.MoveLaterCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>

        <!--
            A component's widget (ADR-0023). One row tall like any card, one or two columns
            wide as its manifest asked.
            <b>The host owns the frame; the component owns the content.</b> Every component card
            wears the same WidgetCard chrome the signal cards do — surface, hairline border,
            radius and padding — so it belongs on the dash rather than reading as a foreign
            rectangle, and it themes with everything else because the chrome uses the theme's own
            brushes. The component draws only what goes inside, and inherits the theme text colour
            and UI font set here, so a widget that sets no colours still looks native. What it
            never gets to do is disagree with the card frame.
            No edit overlay yet — reordering and removing a component card is a later step; for
            now it is placed, shown, and activated by the page like every other card.
        -->
        <DataTemplate DataType="{x:Type vm:ComponentCardViewModel}">
            <Grid Width="{Binding Width}" Height="{x:Static host:BandGrid.WidgetRowHeight}">
                <Border Style="{StaticResource WidgetCard}"
                        TextElement.Foreground="{DynamicResource TextHighBrush}"
                        TextElement.FontFamily="{StaticResource UiFont}">
                    <ContentControl Content="{Binding Element}"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch" />
                </Border>

                <!-- The four-corner "expand" mark: a card with a detail wears it, top-right,
                     so it reads as tappable rather than looking identical to a card that does
                     nothing when touched. Not hit-testable, so the tap falls through to the
                     button below it. -->
                <Path Data="M0,5 L0,0 L5,0 M13,0 L18,0 L18,5 M0,13 L0,18 L5,18 M13,18 L18,18 L18,13"
                      Width="18" Height="18"
                      Stroke="{DynamicResource TextLowBrush}"
                      StrokeThickness="1.6"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Margin="0,16,18,0"
                      IsHitTestVisible="False"
                      Visibility="{Binding HasFullScreen, Converter={StaticResource BoolToVis}}" />

                <!-- Tapping a component that offers a detail opens it full-screen. A component
                     with only a widget has no button, so its card is inert rather than looking
                     tappable and doing nothing. -->
                <Button Style="{StaticResource CardSurfaceButton}"
                        Visibility="{Binding HasFullScreen, Converter={StaticResource BoolToVis}}"
                        Command="{Binding DataContext.OpenComponentDetailCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" />

                <!-- Edit affordances, like a signal card's but without the editor tap — a
                     component card is reordered and removed, not reconfigured here. The scrim
                     and the hit-blocking surface sit over the detail tap, so a card is arranged
                     rather than opened while editing. -->
                <Grid Visibility="{Binding DataContext.IsEditing,
                                           RelativeSource={RelativeSource AncestorType=UserControl},
                                           Converter={StaticResource BoolToVis}}">
                    <Border Background="#B0000000" CornerRadius="14" IsHitTestVisible="False" />
                    <Border Background="Transparent" />

                    <Button Style="{StaticResource CardBadgeButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,-10,-10,0"
                            Content="✕"
                            Command="{Binding DataContext.RemoveCardCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                Margin="-10,0,0,-10">
                        <Button Style="{StaticResource CardBadgeButton}"
                                Content="‹"
                                Command="{Binding DataContext.MoveEarlierCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                        <Button Style="{StaticResource CardBadgeButton}"
                                Margin="8,0,0,0"
                                Content="›"
                                Command="{Binding DataContext.MoveLaterCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- The add tile. Flows through the packer, so it sits exactly where the next card will. -->
        <DataTemplate DataType="{x:Type dash:AddCardSlot}">
            <Button Width="{Binding Width}" Height="{x:Static host:BandGrid.WidgetRowHeight}"
                    Style="{StaticResource AddCardButton}"
                    Command="{Binding DataContext.AddCardCommand,
                                      RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </DataTemplate>

        <!-- One row of cards. -->
        <DataTemplate DataType="{x:Type dash:CardRow}">
            <ItemsControl ItemsSource="{Binding Slots}" Height="{x:Static host:BandGrid.WidgetRowHeight}" Margin="0,0,0,20">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="0,0,20,0" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </DataTemplate>

        <!--
            One page: a full design width, so the strip slides by exactly 912 per page and
            nothing has to know about margins to work out where a page starts.
        -->
        <DataTemplate DataType="{x:Type dash:CardPage}">
            <Grid Width="912">
                <!-- 31 + five 154 columns and their 20 gutters + the last card's trailing
                     gutter + 11 = 912. The right margin is the odd one out because the
                     gutter after the final card is carried by the card itself. -->
                <ItemsControl ItemsSource="{Binding Rows}" Margin="31,20,11,0"
                              VerticalAlignment="Top" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root" ClipToBounds="True" Background="Transparent">

        <!--
            The strip of pages. Slid, not scrolled: see the code-behind.

            It sits in a Canvas, and that is not decoration. A strip of three pages wants
            2736 pixels and the region is 912, so any normal panel arranges it at 912 and
            WPF applies a *layout clip* at that width — the pages past the first are laid
            out, then clipped away before the transform ever moves them, and sliding reveals
            nothing but canvas. A Canvas gives its children their full desired size instead,
            and the clipping that is actually wanted happens once, on Root.
        -->
        <Canvas>
            <ItemsControl x:Name="Strip" ItemsSource="{Binding Pages}">
                <ItemsControl.RenderTransform>
                    <TranslateTransform x:Name="Slide" />
                </ItemsControl.RenderTransform>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Canvas>

        <!-- Nothing left on the dash. Said plainly rather than rendered as a void. -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                    IsHitTestVisible="False">
            <TextBlock Text="NO CARDS"
                       HorizontalAlignment="Center"
                       FontFamily="{StaticResource UiFont}"
                       FontSize="24"
                       Foreground="{DynamicResource TextLowBrush}" />
            <TextBlock Margin="0,10,0,0"
                       HorizontalAlignment="Center"
                       Style="{StaticResource MicroText}"
                       Text="hold the dash to edit, then add one" />
        </StackPanel>

        <!--
            Page dots, in the bottom gutter. Three rows and their gutters use 389 of the two
            390-pixel bands, so the dots live in the last row's own bottom gutter at the edge.
        -->
        <ItemsControl ItemsSource="{Binding Pages}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Bottom"
                      Margin="0,0,0,3"
                      Visibility="{Binding HasMultiplePages, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Command="{Binding DataContext.GoToPageCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding Index}"
                            Style="{StaticResource PageDotButton}">
                        <Button.Tag>
                            <MultiBinding Converter="{StaticResource Equality}">
                                <Binding Path="Index" />
                                <Binding Path="DataContext.PageIndex"
                                         RelativeSource="{RelativeSource AncestorType=UserControl}" />
                            </MultiBinding>
                        </Button.Tag>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
