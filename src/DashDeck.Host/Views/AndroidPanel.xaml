<UserControl x:Class="DashDeck.Host.Views.AndroidPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:emu="clr-namespace:DashDeck.Core.Phone;assembly=DashDeck.Core">

    <UserControl.Resources>
        <!-- The keys' glyphs, drawn on the nav's 24-unit grid. -->
        <Geometry x:Key="AndroidBackGlyph">M15,5 L8,12 L15,19</Geometry>
        <Geometry x:Key="AndroidHomeGlyph">M4,11 L12,4 L20,11 M6.5,9 V20 H17.5 V9</Geometry>
        <Geometry x:Key="AndroidRecentsGlyph">M6,6 H18 V18 H6 Z</Geometry>

        <!-- One of Android's own keys: a line-drawn glyph like the nav's, lit while pressed. -->
        <Style x:Key="AndroidKeyButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Cell" Background="Transparent">
                            <Path x:Name="Glyph" Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                  Stroke="{DynamicResource NavTextBrush}" StrokeThickness="1.75"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="26" Height="26" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Cell" Property="Background" Value="{DynamicResource AccentWashBrush}" />
                                <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource SelectedTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!--
        The picture, and Android's keys beside it: along the bottom when the panel is tall (full
        screen), down the right when it is wide (the stage), so the picture keeps the most of its
        region. The code-behind moves the bar; the picture's own area is what Android is fitted to.
    -->
    <Grid Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition x:Name="KeyRow" Height="64" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="KeyColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="ScreenHost" Background="Black">
            <!--
                Android's screen, from the emulator's frames, in WPF's own tree (ADR-0075) — not the
                emulator's window — so the stage clips it and menus draw over it, as with Android Auto
                (ADR-0057). Scaled uniformly and centred; touch is mapped to the picture as drawn.
            -->
            <Image x:Name="Screen"
                   Source="{Binding Picture}"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="Linear"
                   Visibility="{Binding IsPictureShowing, Converter={StaticResource BoolToVisToken}}" />

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="640"
                        Visibility="{Binding IsPictureShowing, Converter={StaticResource NotBoolToVisToken}}">
                <TextBlock HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           FontFamily="{DynamicResource UiFont}"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextHighBrush}"
                           Text="{Binding Headline}" />

                <TextBlock HorizontalAlignment="Center"
                           Margin="0,14,0,0"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Style="{StaticResource StatusText}"
                           Foreground="{DynamicResource TextMidBrush}"
                           Text="{Binding Detail}" />

                <TextBlock HorizontalAlignment="Center"
                           Margin="0,22,0,0"
                           Style="{StaticResource MicroText}"
                           Text="Tap ANDROID for full screen · double tap for the stage · hold to choose" />
            </StackPanel>
        </Grid>

        <!-- Back, home, and recent apps. -->
        <Border x:Name="KeyBar" Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0">
            <UniformGrid x:Name="KeyGrid" Rows="1">
                <Button Style="{StaticResource AndroidKeyButton}" ToolTip="Back"
                        CommandParameter="{x:Static emu:AndroidKey.Back}" Command="{Binding PressCommand}"
                        Content="{StaticResource AndroidBackGlyph}" />
                <Button Style="{StaticResource AndroidKeyButton}" ToolTip="Home"
                        CommandParameter="{x:Static emu:AndroidKey.Home}" Command="{Binding PressCommand}"
                        Content="{StaticResource AndroidHomeGlyph}" />
                <Button Style="{StaticResource AndroidKeyButton}" ToolTip="Recent apps"
                        CommandParameter="{x:Static emu:AndroidKey.Recents}" Command="{Binding PressCommand}"
                        Content="{StaticResource AndroidRecentsGlyph}" />
            </UniformGrid>
        </Border>
    </Grid>
</UserControl>
