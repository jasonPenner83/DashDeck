<UserControl x:Class="DashDeck.Host.Views.StereoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="912" Height="390"
             Background="{DynamicResource CanvasBrush}">

    <UserControl.Resources>
        <!-- MainWindow declares its own; this panel is loaded on its own in tests and shots,
             so it carries one rather than relying on an ancestor's. -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <!-- The bottom third, the same 912 x 390 the climate panel and the console use.
         Left: what is playing and the controls. Right: the queue. -->
    <Grid Margin="31,14,31,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="328" />
        </Grid.ColumnDefinitions>

        <!-- Now playing and transport -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource MicroText}" Text="STEREO" />

            <TextBlock Grid.Row="1" Margin="0,8,0,0"
                       Text="{Binding Title}"
                       FontFamily="{DynamicResource UiFont}"
                       FontSize="30"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextHighBrush}" />

            <TextBlock Grid.Row="2" Margin="0,2,0,0"
                       Text="{Binding Album}"
                       Style="{StaticResource CaptionText}"
                       TextTrimming="CharacterEllipsis" />

            <!-- Position. A bar plus tap-to-seek rather than a slider: a thumb is a poor
                 target in a moving truck, and a tap anywhere on the line is unambiguous. -->
            <StackPanel Grid.Row="3" VerticalAlignment="Center">
                <Border x:Name="SeekStrip"
                        Background="Transparent"
                        Padding="0,12"
                        Cursor="Hand"
                        MouseLeftButtonDown="SeekStrip_MouseLeftButtonDown">
                    <ProgressBar Height="8"
                                 Minimum="0" Maximum="1"
                                 Value="{Binding Progress, Mode=OneWay}"
                                 Background="{DynamicResource HairlineBrush}"
                                 Foreground="{DynamicResource AccentBrush}"
                                 BorderThickness="0" />
                </Border>

                <Grid Margin="0,2,0,0">
                    <TextBlock HorizontalAlignment="Left"
                               Text="{Binding Elapsed}"
                               FontFamily="{DynamicResource MonoFont}"
                               FontSize="13"
                               Foreground="{DynamicResource TextMidBrush}" />
                    <TextBlock HorizontalAlignment="Right"
                               Text="{Binding Duration}"
                               FontFamily="{DynamicResource MonoFont}"
                               FontSize="13"
                               Foreground="{DynamicResource TextLowBrush}" />
                </Grid>

                <!-- Why the music is quieter or stopped, when something else wants the
                     speakers (Q14). Silence about it would look like a fault. -->
                <TextBlock Margin="0,8,0,0"
                           Text="{Binding DuckReason}"
                           Style="{StaticResource MicroText}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource AccentBrush}"
                           Visibility="{Binding IsDucked, Converter={StaticResource BoolToVis}}" />
            </StackPanel>

            <!-- Transport and volume -->
            <Grid Grid.Row="4" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Style="{StaticResource OptionChipButton}"
                            Content="PREV"
                            Command="{Binding PreviousCommand}" />
                    <Button Style="{StaticResource OptionChipButton}"
                            MinWidth="128"
                            Content="{Binding PlayLabel}"
                            Command="{Binding TogglePlayCommand}" />
                    <Button Style="{StaticResource OptionChipButton}"
                            Content="NEXT"
                            Command="{Binding NextCommand}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource MicroText}" Text="VOL" VerticalAlignment="Center" />
                    <Slider Width="150" Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Minimum="0" Maximum="100"
                            IsSnapToTickEnabled="True" TickFrequency="5"
                            Value="{Binding Volume, Mode=TwoWay}" />
                    <TextBlock Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Text="{Binding Volume}"
                               FontFamily="{DynamicResource MonoFont}"
                               FontSize="13"
                               Foreground="{DynamicResource TextMidBrush}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- The queue -->
        <Border Grid.Column="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource HairlineBrush}"
                BorderThickness="{DynamicResource BorderWidth}"
                CornerRadius="{DynamicResource PanelRadius}">
            <Grid Margin="14,12,8,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource MicroText}" Text="QUEUE" />

                <!-- Nothing to play, and why. -->
                <TextBlock Grid.Row="1" Margin="0,10,6,0"
                           Text="{Binding Problem}"
                           Style="{StaticResource CaptionText}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Top"
                           Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}" />

                <ScrollViewer Grid.Row="1" Margin="0,8,0,0"
                              VerticalScrollBarVisibility="Auto"
                              PanningMode="VerticalOnly"
                              Visibility="{Binding HasTracks, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Tracks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Height="42"
                                        HorizontalContentAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Command="{Binding DataContext.PlayTrackCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Grid.Column="0"
                                                 Width="6" Height="6"
                                                 VerticalAlignment="Center"
                                                 Fill="{DynamicResource AccentBrush}"
                                                 Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}" />

                                        <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontFamily="{DynamicResource UiFont}"
                                                       FontSize="14"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextHighBrush}" />
                                            <TextBlock Text="{Binding Folder}"
                                                       Style="{StaticResource MicroText}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
