<UserControl x:Class="DashDeck.Host.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DashDeck.Host.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:NonEmptyToVisibleConverter x:Key="EmptyToCollapsed" />

        <!-- A rail tab. Selected when its section is showing, from the section's own IsSelected. -->
        <Style x:Key="SettingsTab" TargetType="Button">
            <Setter Property="Height" Value="58" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextMidBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="12" Padding="18,0,0,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentWashBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The rail. One tab per section; the pane on the right follows. -->
        <Border Grid.Column="0" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,1,0">
            <ItemsControl ItemsSource="{Binding Sections}" Margin="24,26,16,24">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource SettingsTab}"
                                Command="{Binding DataContext.SelectSectionCommand,
                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <TextBlock Text="{Binding Name}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="15" />
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Grid Grid.Column="1">

            <!-- ── APPEARANCE ─────────────────────────────────────────────── -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsAppearance, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="31,26,31,24">

                    <TextBlock Style="{StaticResource CaptionText}" Text="THEME" />

                    <!-- Day / Night / Auto -->
                    <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding Modes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource StageLauncherButton}"
                                        Height="72" MinWidth="170"
                                        Command="{Binding DataContext.SetModeCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="14"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Detail}"
                                                   Margin="0,5,0,0"
                                                   HorizontalAlignment="Center"
                                                   Style="{StaticResource MicroText}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- An automatic setting that will not say why it did something is infuriating. -->
                    <StackPanel Margin="2,14,0,0" Visibility="{Binding IsAuto, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding AutoSource}" Style="{StaticResource CaptionText}" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource MicroText}"
                                   Text="Headlights would be the better signal — not available over standard OBD-II." />
                    </StackPanel>

                    <!-- Accent -->
                    <TextBlock Margin="0,34,0,0" Style="{StaticResource CaptionText}" Text="ACCENT" />

                    <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding Accents}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource StageLauncherButton}"
                                        Height="72" MinWidth="150"
                                        Command="{Binding DataContext.SetAccentCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="22" Height="22" Fill="{Binding Swatch}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Label}"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="13" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Any colour, checked as it is typed (ADR-0014). -->
                    <TextBlock Margin="0,30,0,0" Style="{StaticResource CaptionText}" Text="CUSTOM" />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Border Width="56" Height="56"
                                CornerRadius="14"
                                Background="{Binding CustomPreview}"
                                BorderBrush="{DynamicResource HairlineStrongBrush}"
                                BorderThickness="1" />
                        <TextBox Style="{StaticResource InputField}"
                                 Width="190"
                                 Margin="12,0,0,0"
                                 MaxLength="7"
                                 CharacterCasing="Upper"
                                 Text="{Binding CustomAccentHex, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Style="{StaticResource StageLauncherButton}"
                                Height="56" MinWidth="130"
                                Margin="12,0,0,0"
                                Command="{Binding ApplyCustomAccentCommand}">
                            <TextBlock Text="USE IT" FontFamily="{StaticResource MonoFont}" FontSize="13" />
                        </Button>
                    </StackPanel>

                    <TextBlock Margin="2,12,0,0"
                               MaxWidth="620"
                               HorizontalAlignment="Left"
                               TextWrapping="Wrap"
                               Style="{StaticResource MicroText}"
                               Foreground="{Binding CustomMessageBrush}"
                               Text="{Binding CustomMessage}" />

                    <TextBlock Margin="2,26,0,0"
                               MaxWidth="620"
                               HorizontalAlignment="Left"
                               TextWrapping="Wrap"
                               Style="{StaticResource MicroText}"
                               Text="The four signal-quality colours are fixed. Live, stale, unavailable and simulated have to mean the same thing on every dash, whatever else is adjusted." />

                    <TextBlock Margin="2,20,0,0"
                               Style="{StaticResource CaptionText}"
                               Text="{Binding ResolvedTheme, StringFormat=CURRENTLY {0}}" />

                    <TextBlock Margin="2,8,0,0"
                               MaxWidth="620"
                               HorizontalAlignment="Left"
                               TextWrapping="Wrap"
                               Style="{StaticResource MicroText}"
                               Text="{Binding SettingsPath, StringFormat=Saved to {0} — kept across updates.}" />
                </StackPanel>
            </ScrollViewer>

            <!-- ── MOUNT ──────────────────────────────────────────────────── -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsMount, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="31,26,31,24">
                    <TextBlock Style="{StaticResource CaptionText}" Text="MOUNT LEVELLING" />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource StageLauncherButton}"
                                Height="56" MinWidth="240"
                                Command="{Binding LevelCommand}">
                            <TextBlock Text="{Binding LevelCaption}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="14" />
                        </Button>
                    </StackPanel>

                    <TextBlock Margin="2,12,0,0"
                               MaxWidth="620"
                               HorizontalAlignment="Left"
                               TextWrapping="Wrap"
                               Style="{StaticResource MicroText}"
                               Text="{Binding LevelDetail}" />

                    <TextBlock Margin="2,10,0,0"
                               MaxWidth="620"
                               HorizontalAlignment="Left"
                               TextWrapping="Wrap"
                               Style="{StaticResource MicroText}"
                               Text="Park somewhere flat with the tablet in its cradle first. A Surface on a kickstand reads 69° of pitch sitting still, so the mount angle has to be measured before pitch, roll or G mean anything." />
                </StackPanel>
            </ScrollViewer>

            <!-- ── DISPLAY ────────────────────────────────────────────────── -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsDisplay, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="31,26,31,24">
                    <TextBlock Style="{StaticResource CaptionText}" Text="WEB SCALE" />

                    <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding WebScales}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource OptionChipButton}"
                                        MinWidth="104"
                                        Command="{Binding DataContext.SetWebScaleCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding Label}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="15" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Margin="2,6,0,0"
                               MaxWidth="620"
                               HorizontalAlignment="Left"
                               TextWrapping="Wrap"
                               Style="{StaticResource MicroText}"
                               Text="Applies to Spotify, Apple Music, Maps, Nuvio and Stremio — live, including whatever is on the stage right now." />

                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,30,0,0" Text="STAGE AUDIO" />

                    <Button Style="{StaticResource StageLauncherButton}"
                            Height="52" MinWidth="330" Margin="0,14,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding ToggleKeepStageAudioCommand}">
                        <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="14">
                            <Run Text="KEEP PLAYING WHEN YOU SWITCH —" />
                            <Run Text="{Binding KeepStageAudioLabel, Mode=OneWay}" FontWeight="Bold" />
                        </TextBlock>
                    </Button>

                    <TextBlock Margin="2,12,0,0"
                               MaxWidth="620"
                               HorizontalAlignment="Left"
                               TextWrapping="Wrap"
                               Style="{StaticResource MicroText}"
                               Text="On: a source — Spotify, Music, video, Stremio, Nuvio, phone — keeps playing when you switch the stage to a screen like the gauges, and the ▶ pill in the status bar brings it back. Off: switching stops it." />

                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,30,0,0" Text="LOCATION (PHONE GPS)" />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource StageLauncherButton}"
                                Height="52" MinWidth="180"
                                Command="{Binding ToggleGpsCommand}">
                            <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="14">
                                <Run Text="USE PHONE GPS —" />
                                <Run Text="{Binding GpsEnabledLabel, Mode=OneWay}" FontWeight="Bold" />
                            </TextBlock>
                        </Button>
                        <Button Style="{StaticResource StageLauncherButton}"
                                Height="52" MinWidth="180" Margin="14,0,0,0"
                                Command="{Binding ToggleGpsTransportCommand}">
                            <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="14">
                                <Run Text="VIA —" />
                                <Run Text="{Binding GpsTransportLabel, Mode=OneWay}" FontWeight="Bold" />
                            </TextBlock>
                        </Button>
                    </StackPanel>

                    <!-- Bluetooth: pick the phone's paired COM port. -->
                    <StackPanel Margin="0,16,0,0"
                                Visibility="{Binding IsBluetoothGps, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="PHONE COM PORT" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <ItemsControl ItemsSource="{Binding SerialPorts}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource OptionChipButton}" MinWidth="96"
                                                Command="{Binding DataContext.SelectSerialPortCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="{Binding Name}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="14" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource StageLauncherButton}"
                                    Height="56" MinWidth="110" VerticalAlignment="Top"
                                    Command="{Binding RefreshSerialPortsCommand}">
                                <TextBlock Text="REFRESH" FontFamily="{StaticResource MonoFont}" FontSize="13" />
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Network: the host:port the phone's app serves NMEA on. -->
                    <StackPanel Margin="0,16,0,0"
                                Visibility="{Binding IsNetworkGps, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="PHONE APP HOST:PORT" />
                        <TextBox Style="{StaticResource InputField}" Width="230" Margin="0,10,0,0"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding Display.GpsEndpoint, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <TextBlock Margin="2,14,0,0"
                               MaxWidth="640"
                               HorizontalAlignment="Left"
                               TextWrapping="Wrap"
                               Style="{StaticResource MicroText}"
                               Text="Run a GPS-share app on your Android phone (e.g. gpsdRelay or Share GPS) that outputs NMEA. Bluetooth: pair the phone in Windows Bluetooth settings, then pick the COM port it appears as — no Wi-Fi needed. Network: the app serves NMEA over TCP; put its host:port here. Takes effect at the next launch. Heading and position read PHONE; speed falls back to the truck's own when the adapter is plugged in." />
                </StackPanel>
            </ScrollViewer>

            <!-- ── APPS (ADR-0024) ───────────────────────────────────────── -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsApps, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="31,26,31,24">
                    <TextBlock Style="{StaticResource CaptionText}" Text="STAGE APPS" />

                    <TextBlock Margin="2,10,0,0" MaxWidth="620" HorizontalAlignment="Left"
                               TextWrapping="Wrap" Style="{StaticResource MicroText}"
                               Text="Point the stage at a program already on this tablet — a browser, a player. It launches with your privileges and DashDeck does not sandbox it. This is a launcher, not an app store." />

                    <!-- The apps that ship with DashDeck: listed for reference, not editable —
                         their curated install paths are why they stay in code (ADR-0024). -->
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,22,0,0" Text="BUILT-IN" />

                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding BuiltInApps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                    <TextBlock Text="{Binding Name}" Width="120"
                                               FontFamily="{StaticResource MonoFont}" FontSize="14"
                                               Foreground="{DynamicResource TextMidBrush}" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource MicroText}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,22,0,0" Text="YOURS" />

                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,0"
                               Text="NAME · EXECUTABLE · ARGUMENTS (OPTIONAL)" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBox Style="{StaticResource InputField}" Width="150"
                                 CharacterCasing="Upper"
                                 Text="{Binding NewAppName, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Style="{StaticResource StageLauncherButton}"
                                Height="56" MinWidth="118" Margin="12,0,0,0"
                                Command="{Binding BrowseCommand}">
                            <TextBlock Text="BROWSE…" FontFamily="{StaticResource MonoFont}" FontSize="13" />
                        </Button>
                        <TextBox Style="{StaticResource InputField}" Width="200" Margin="12,0,0,0"
                                 Text="{Binding NewAppArguments, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Style="{StaticResource StageLauncherButton}"
                                Height="56" MinWidth="90" Margin="12,0,0,0"
                                Command="{Binding AddAppCommand}">
                            <TextBlock Text="ADD" FontFamily="{StaticResource MonoFont}" FontSize="13" />
                        </Button>
                    </StackPanel>

                    <!-- Whether this app plays audio and should keep going in the background when
                         you switch to a screen (ADR-0026). Off by default. -->
                    <Button Style="{StaticResource StageLauncherButton}"
                            Height="46" MinWidth="300" Margin="0,12,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding ToggleNewAppKeepPlayingCommand}">
                        <TextBlock Text="{Binding NewAppKeepPlayingLabel}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="13" />
                    </Button>

                    <TextBlock Margin="2,12,0,0" MaxWidth="620" HorizontalAlignment="Left"
                               TextWrapping="Wrap" Style="{StaticResource MicroText}"
                               Foreground="{Binding AppMessageBrush}"
                               Text="{Binding AppMessage}" />

                    <TextBlock Margin="2,4,0,0" MaxWidth="620" HorizontalAlignment="Left"
                               TextWrapping="Wrap" Style="{StaticResource MicroText}"
                               Text="{Binding NewAppPath, StringFormat=Chosen: {0}}"
                               Visibility="{Binding NewAppPath, Converter={StaticResource EmptyToCollapsed}}" />

                    <ItemsControl Margin="0,22,0,0" ItemsSource="{Binding Apps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
                                        CornerRadius="12" Padding="14,10,10,10" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="15"
                                                           Foreground="{DynamicResource TextHighBrush}" />
                                                <TextBlock Text="▶ keeps playing" Margin="10,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource MicroText}"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           Visibility="{Binding KeepPlaying, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                            <TextBlock Margin="0,3,0,0" Style="{StaticResource MicroText}"
                                                       TextTrimming="CharacterEllipsis" Text="{Binding Path}" />
                                        </StackPanel>

                                        <Button Grid.Column="1" Style="{StaticResource CardBadgeButton}"
                                                Content="✕" VerticalAlignment="Center"
                                                Command="{Binding DataContext.RemoveAppCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Margin="2,6,0,0" MaxWidth="620" HorizontalAlignment="Left"
                               TextWrapping="Wrap" Style="{StaticResource MicroText}"
                               Text="{Binding AppsPath, StringFormat=Saved to {0} — kept across updates.}" />
                </StackPanel>
            </ScrollViewer>

            <!-- ── DIAGNOSTICS ────────────────────────────────────────────── -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsDiagnostics, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="31,26,31,24">
                    <TextBlock Style="{StaticResource CaptionText}" Text="DIAGNOSTICS" />

                    <TextBlock Margin="2,14,0,0"
                               Style="{StaticResource StatusText}"
                               Foreground="{DynamicResource TextMidBrush}"
                               Text="{Binding DataContext.SourceLabel, RelativeSource={RelativeSource AncestorType=Window}}" />

                    <TextBlock Margin="2,6,0,0"
                               Style="{StaticResource MicroText}"
                               Text="{Binding DataContext.DriveLabel, RelativeSource={RelativeSource AncestorType=Window},
                                              StringFormat=Scripted drive: {0}}" />

                    <TextBlock Margin="2,6,0,0"
                               MaxWidth="620"
                               HorizontalAlignment="Left"
                               TextWrapping="Wrap"
                               Style="{StaticResource MicroText}"
                               Text="{Binding DataContext.RequestRateText, RelativeSource={RelativeSource AncestorType=Window},
                                              StringFormat={}{0} — measured adapter capability rather than load.}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
