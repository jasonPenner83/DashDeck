<UserControl x:Class="DashDeck.Host.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DashDeck.Host.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:NonEmptyToVisibleConverter x:Key="EmptyToCollapsed" />

        <!-- A rail tab. Selected when its section is showing, from the section's own IsSelected. -->
        <Style x:Key="SettingsTab" TargetType="Button">
            <Setter Property="Height" Value="58" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextMidBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="12" Padding="18,0,0,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentWashBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A whole row you tap to open it: a signal in the Sensors inventory. -->
        <Style x:Key="SensorRowButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="14,9,14,9" MinHeight="56">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A refusal reads in the fault red the dash uses for a fault (QualityPalette.Fault). -->
        <Style x:Key="EditorMessage" TargetType="TextBlock" BasedOn="{StaticResource MicroText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasProblems}" Value="True">
                    <Setter Property="Foreground" Value="#FFE5544B" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A labelled field in the editor: caption above, input below. -->
        <Style x:Key="EditorField" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,12,14" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The rail. One tab per section; the pane on the right follows. -->
        <Border Grid.Column="0" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,1,0">
            <ItemsControl ItemsSource="{Binding Sections}" Margin="24,26,16,24">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource SettingsTab}"
                                Command="{Binding DataContext.SelectSectionCommand,
                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <TextBlock Text="{Binding Name}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="15" />
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Grid Grid.Column="1">

            <!-- ── APPEARANCE ─────────────────────────────────────────────── -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsAppearance, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="31,26,31,24">

                    <TextBlock Style="{StaticResource CaptionText}" Text="THEME" />

                    <!-- Day / Night / Auto -->
                    <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding Modes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource StageLauncherButton}"
                                        Height="72" MinWidth="170"
                                        Command="{Binding DataContext.SetModeCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="14"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Detail}"
                                                   Margin="0,5,0,0"
                                                   HorizontalAlignment="Center"
                                                   Style="{StaticResource MicroText}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- An automatic setting that will not say why it did something is infuriating. -->
                    <StackPanel Margin="2,14,0,0" Visibility="{Binding IsAuto, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding AutoSource}" Style="{StaticResource CaptionText}" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource MicroText}"
                                   Text="Headlights would be the better signal — not available over standard OBD-II." />
                    </StackPanel>

                    <!-- Accent -->
                    <TextBlock Margin="0,34,0,0" Style="{StaticResource CaptionText}" Text="ACCENT" />

                    <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding Accents}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource StageLauncherButton}"
                                        Height="72" MinWidth="150"
                                        Command="{Binding DataContext.SetAccentCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="22" Height="22" Fill="{Binding Swatch}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Label}"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="13" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Any colour, checked as it is typed (ADR-0014). -->
                    <TextBlock Margin="0,30,0,0" Style="{StaticResource CaptionText}" Text="CUSTOM" />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Border Width="56" Height="56"
                                CornerRadius="14"
                                Background="{Binding CustomPreview}"
                                BorderBrush="{DynamicResource HairlineStrongBrush}"
                                BorderThickness="1" />
                        <TextBox Style="{StaticResource InputField}"
                                 Width="190"
                                 Margin="12,0,0,0"
                                 MaxLength="7"
                                 CharacterCasing="Upper"
                                 Text="{Binding CustomAccentHex, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Style="{StaticResource StageLauncherButton}"
                                Height="56" MinWidth="130"
                                Margin="12,0,0,0"
                                Command="{Binding ApplyCustomAccentCommand}">
                            <TextBlock Text="USE IT" FontFamily="{StaticResource MonoFont}" FontSize="13" />
                        </Button>
                    </StackPanel>

                    <TextBlock Margin="2,12,0,0"
                               MaxWidth="620"
                               HorizontalAlignment="Left"
                               TextWrapping="Wrap"
                               Style="{StaticResource MicroText}"
                               Foreground="{Binding CustomMessageBrush}"
                               Text="{Binding CustomMessage}" />

                    <TextBlock Margin="2,26,0,0"
                               MaxWidth="620"
                               HorizontalAlignment="Left"
                               TextWrapping="Wrap"
                               Style="{StaticResource MicroText}"
                               Text="The four signal-quality colours are fixed. Live, stale, unavailable and simulated have to mean the same thing on every dash, whatever else is adjusted." />

                    <TextBlock Margin="2,20,0,0"
                               Style="{StaticResource CaptionText}"
                               Text="{Binding ResolvedTheme, StringFormat=CURRENTLY {0}}" />

                    <TextBlock Margin="2,8,0,0"
                               MaxWidth="620"
                               HorizontalAlignment="Left"
                               TextWrapping="Wrap"
                               Style="{StaticResource MicroText}"
                               Text="{Binding SettingsPath, StringFormat=Saved to {0} — kept across updates.}" />
                </StackPanel>
            </ScrollViewer>

            <!-- ── MOUNT ──────────────────────────────────────────────────── -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsMount, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="31,26,31,24">
                    <TextBlock Style="{StaticResource CaptionText}" Text="MOUNT LEVELLING" />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource StageLauncherButton}"
                                Height="56" MinWidth="240"
                                Command="{Binding LevelCommand}">
                            <TextBlock Text="{Binding LevelCaption}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="14" />
                        </Button>
                    </StackPanel>

                    <TextBlock Margin="2,12,0,0"
                               MaxWidth="620"
                               HorizontalAlignment="Left"
                               TextWrapping="Wrap"
                               Style="{StaticResource MicroText}"
                               Text="{Binding LevelDetail}" />

                    <TextBlock Margin="2,10,0,0"
                               MaxWidth="620"
                               HorizontalAlignment="Left"
                               TextWrapping="Wrap"
                               Style="{StaticResource MicroText}"
                               Text="Park somewhere flat with the tablet in its cradle first. A Surface on a kickstand reads 69° of pitch sitting still, so the mount angle has to be measured before pitch, roll or G mean anything." />
                </StackPanel>
            </ScrollViewer>

            <!-- ── DISPLAY ────────────────────────────────────────────────── -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsDisplay, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="31,26,31,24">
                    <TextBlock Style="{StaticResource CaptionText}" Text="WEB SCALE" />

                    <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding WebScales}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource OptionChipButton}"
                                        MinWidth="104"
                                        Command="{Binding DataContext.SetWebScaleCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding Label}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="15" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Margin="2,6,0,0"
                               MaxWidth="620"
                               HorizontalAlignment="Left"
                               TextWrapping="Wrap"
                               Style="{StaticResource MicroText}"
                               Text="Applies to Spotify, Apple Music, Maps, Nuvio and Stremio — live, including whatever is on the stage right now." />

                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,30,0,0" Text="STAGE AUDIO" />

                    <Button Style="{StaticResource StageLauncherButton}"
                            Height="52" MinWidth="330" Margin="0,14,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding ToggleKeepStageAudioCommand}">
                        <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="14">
                            <Run Text="KEEP PLAYING WHEN YOU SWITCH —" />
                            <Run Text="{Binding KeepStageAudioLabel, Mode=OneWay}" FontWeight="Bold" />
                        </TextBlock>
                    </Button>

                    <TextBlock Margin="2,12,0,0"
                               MaxWidth="620"
                               HorizontalAlignment="Left"
                               TextWrapping="Wrap"
                               Style="{StaticResource MicroText}"
                               Text="On: a source — Spotify, Music, video, Stremio, Nuvio, phone — keeps playing when you switch the stage to a screen like the gauges, and the ▶ pill in the status bar brings it back. Off: switching stops it." />

                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,30,0,0" Text="LOCATION (PHONE GPS)" />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource StageLauncherButton}"
                                Height="52" MinWidth="180"
                                Command="{Binding ToggleGpsCommand}">
                            <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="14">
                                <Run Text="USE PHONE GPS —" />
                                <Run Text="{Binding GpsEnabledLabel, Mode=OneWay}" FontWeight="Bold" />
                            </TextBlock>
                        </Button>
                        <Button Style="{StaticResource StageLauncherButton}"
                                Height="52" MinWidth="180" Margin="14,0,0,0"
                                Command="{Binding ToggleGpsTransportCommand}">
                            <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="14">
                                <Run Text="VIA —" />
                                <Run Text="{Binding GpsTransportLabel, Mode=OneWay}" FontWeight="Bold" />
                            </TextBlock>
                        </Button>
                    </StackPanel>

                    <!-- Bluetooth: pick the phone's paired COM port. -->
                    <StackPanel Margin="0,16,0,0"
                                Visibility="{Binding IsBluetoothGps, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="PHONE COM PORT" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <ItemsControl ItemsSource="{Binding SerialPorts}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource OptionChipButton}" MinWidth="96"
                                                Command="{Binding DataContext.SelectSerialPortCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="{Binding Name}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="14" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource StageLauncherButton}"
                                    Height="56" MinWidth="110" VerticalAlignment="Top"
                                    Command="{Binding RefreshSerialPortsCommand}">
                                <TextBlock Text="REFRESH" FontFamily="{StaticResource MonoFont}" FontSize="13" />
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Network: the host:port the phone's app serves NMEA on. -->
                    <StackPanel Margin="0,16,0,0"
                                Visibility="{Binding IsNetworkGps, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="PHONE APP HOST:PORT" />
                        <TextBox Style="{StaticResource InputField}" Width="230" Margin="0,10,0,0"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding Display.GpsEndpoint, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <TextBlock Margin="2,14,0,0"
                               MaxWidth="640"
                               HorizontalAlignment="Left"
                               TextWrapping="Wrap"
                               Style="{StaticResource MicroText}"
                               Text="Run a GPS-share app on your Android phone (e.g. gpsdRelay or Share GPS) that outputs NMEA. Bluetooth: pair the phone in Windows Bluetooth settings, then pick the COM port it appears as — no Wi-Fi needed. Network: the app serves NMEA over TCP; put its host:port here. Takes effect at the next launch. Heading and position read PHONE; speed falls back to the truck's own when the adapter is plugged in." />
                </StackPanel>
            </ScrollViewer>

            <!-- ── VEHICLE (ADR-0029) ────────────────────────────────────── -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsVehicle, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="31,26,31,24">
                    <TextBlock Style="{StaticResource CaptionText}" Text="THE TRUCK" />

                    <TextBlock Margin="2,10,0,0" MaxWidth="620" HorizontalAlignment="Left"
                               TextWrapping="Wrap" Style="{StaticResource MicroText}"
                               Text="Facts about your F-150 the dash needs but can't read off the bus. Components read them — the range estimate uses the tank size. More factors will land here." />

                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,22,0,0" Text="FUEL TANK (LITRES)" />

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBox Style="{StaticResource InputField}" Width="150"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding Display.FuelTankLitres, UpdateSourceTrigger=LostFocus, StringFormat=0}" />
                        <TextBlock Text="{Binding Display.FuelTankGallons}" Margin="14,0,0,0"
                                   VerticalAlignment="Center" Style="{StaticResource MicroText}" />
                    </StackPanel>

                    <TextBlock Margin="2,12,0,0" MaxWidth="620" HorizontalAlignment="Left"
                               TextWrapping="Wrap" Style="{StaticResource MicroText}"
                               Text="A 2019 F-150 ships a 23, 26 or 36 US-gallon tank (≈ 87, 98 or 136 L). Yours is the 36. Takes effect at the next launch — a tank doesn't change size while you drive." />

                    <!-- The real adapter (ADR-0031). Empty is the default and stays the
                         default: most of this tablet's life is nowhere near the truck. -->
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,28,0,0" Text="OBD-II ADAPTER · COM PORT" />

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBox Style="{StaticResource InputField}" Width="150"
                                 CharacterCasing="Upper"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding Display.AdapterSerialPort, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{Binding DetectedSerialPorts}" Margin="14,0,0,0"
                                   VerticalAlignment="Center" Style="{StaticResource MicroText}" />
                    </StackPanel>

                    <TextBlock Margin="2,12,0,0" MaxWidth="620" HorizontalAlignment="Left"
                               TextWrapping="Wrap" Style="{StaticResource MicroText}"
                               Text="Leave empty to run the synthetic truck — the SIM badge in the status strip tells you which you're looking at. Set it to the adapter's port (FORScan's connection screen shows it) to read the real bus. The baud rate is worked out automatically. Takes effect at the next launch; if the adapter doesn't answer, the dash comes up simulated rather than dead, and says why." />
                </StackPanel>
            </ScrollViewer>

            <!-- ── SENSORS (ADR-0032) ────────────────────────────────────── -->
            <Grid Visibility="{Binding IsSensors, Converter={StaticResource BoolToVis}}">
                <Grid DataContext="{Binding Inventory}">

                    <!-- The inventory: every signal and sensor, the scan, the way in to the editor. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsListing, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="31,26,31,24">
                            <TextBlock Style="{StaticResource CaptionText}" Text="SENSORS" />

                            <TextBlock Margin="2,10,0,0" MaxWidth="620" HorizontalAlignment="Left"
                                       TextWrapping="Wrap" Style="{StaticResource MicroText}"
                                       Text="Everything the dash can show, and where it comes from. Tap a signal to correct it. NOT ASKED means nothing has wanted it since launch — listing a signal here never polls it." />

                            <!-- Never silent: a dropped overlay looks exactly like signals that vanished. -->
                            <TextBlock Margin="2,12,0,0" MaxWidth="620" HorizontalAlignment="Left"
                                       TextWrapping="Wrap" Style="{StaticResource MicroText}"
                                       Foreground="#FFE5544B"
                                       Text="{Binding Problem}"
                                       Visibility="{Binding Problem, Converter={StaticResource EmptyToCollapsed}}" />

                            <Border Margin="0,16,0,0" Padding="16,12,12,12" CornerRadius="12"
                                    Background="{DynamicResource AccentWashBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                    Visibility="{Binding RestartNeeded, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                                               Style="{StaticResource MicroText}"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Text="Changes are saved and take effect at the next launch." />
                                    <Button Grid.Column="1" Style="{StaticResource StageLauncherButton}"
                                            Height="48" Margin="12,0,0,0"
                                            Command="{Binding RestartCommand}"
                                            Visibility="{Binding CanRestart, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="RESTART NOW" FontFamily="{StaticResource MonoFont}" FontSize="13" />
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Find -->
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,24,0,0" Text="FIND MISSING" />

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Style="{StaticResource StageLauncherButton}" MinWidth="170"
                                        Command="{Binding ScanCommand}">
                                    <TextBlock Text="SCAN THE TRUCK" FontFamily="{StaticResource MonoFont}" FontSize="13" />
                                </Button>
                                <Button Style="{StaticResource StageLauncherButton}" MinWidth="170"
                                        Command="{Binding NewCommand}">
                                    <TextBlock Text="+ NEW SIGNAL" FontFamily="{StaticResource MonoFont}" FontSize="13" />
                                </Button>
                            </StackPanel>

                            <TextBlock Margin="2,10,0,0" MaxWidth="620" HorizontalAlignment="Left"
                                       TextWrapping="Wrap" Style="{StaticResource MicroText}"
                                       Text="{Binding ScanStatus}" />

                            <StackPanel Visibility="{Binding HasScanned, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,16,0,0"
                                           Text="SUPPORTED BY THE TRUCK, NOT IN THE CATALOG" />
                                <ItemsControl ItemsSource="{Binding Missing}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SensorRowButton}"
                                                    Command="{Binding DataContext.AddMissingCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Caption}" TextTrimming="CharacterEllipsis"
                                                                   FontFamily="{StaticResource MonoFont}" FontSize="14"
                                                                   Foreground="{DynamicResource TextHighBrush}" />
                                                        <TextBlock Margin="0,3,0,0" Style="{StaticResource MicroText}" Text="{Binding Detail}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="+ ADD" VerticalAlignment="Center" Margin="12,0,0,0"
                                                               FontFamily="{StaticResource MonoFont}" FontSize="13"
                                                               Foreground="{DynamicResource AccentBrush}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,16,0,0"
                                           Text="IN THE CATALOG, NOT SUPPORTED BY THE TRUCK" />
                                <ItemsControl ItemsSource="{Binding Unsupported}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SensorRowButton}"
                                                    Command="{Binding DataContext.EditCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Caption}" TextTrimming="CharacterEllipsis"
                                                               FontFamily="{StaticResource MonoFont}" FontSize="14"
                                                               Foreground="{DynamicResource TextMidBrush}" />
                                                    <TextBlock Margin="0,3,0,0" Style="{StaticResource MicroText}" Text="{Binding Detail}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Show -->
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,26,0,0" Text="VEHICLE SIGNALS" />

                            <TextBox Style="{StaticResource InputField}" Margin="0,4,0,0"
                                     Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Margin="2,10,0,0" Style="{StaticResource MicroText}" Text="{Binding Summary}" />

                            <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Groups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Header}" />
                                            <ItemsControl ItemsSource="{Binding Rows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource SensorRowButton}"
                                                                Command="{Binding DataContext.EditCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
                                                                CommandParameter="{Binding}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding Caption}" TextTrimming="CharacterEllipsis"
                                                                                   FontFamily="{StaticResource MonoFont}" FontSize="14"
                                                                                   Foreground="{DynamicResource TextHighBrush}" />
                                                                        <TextBlock Text="{Binding OriginLabel}" Margin="10,0,0,0"
                                                                                   VerticalAlignment="Center"
                                                                                   Style="{StaticResource MicroText}"
                                                                                   Foreground="{DynamicResource AccentBrush}" />
                                                                    </StackPanel>
                                                                    <TextBlock Margin="0,3,0,0" Style="{StaticResource MicroText}"
                                                                               TextTrimming="CharacterEllipsis" Text="{Binding Detail}" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                            VerticalAlignment="Center" Margin="12,0,0,0">
                                                                    <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                                                             Fill="{Binding Quality, Converter={StaticResource QualityBrushToken}}" />
                                                                    <TextBlock Text="{Binding StatusText}" Margin="8,0,0,0"
                                                                               VerticalAlignment="Center"
                                                                               FontFamily="{StaticResource MonoFont}" FontSize="13"
                                                                               Foreground="{Binding Quality, Converter={StaticResource ValueBrushToken}}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- The tablet's own sensors and the phone's GPS: hardware, listed for reference. -->
                            <StackPanel Visibility="{Binding HasTabletSensors, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,16,0,0" Text="TABLET AND PHONE" />
                                <TextBlock Margin="2,0,0,10" MaxWidth="620" HorizontalAlignment="Left"
                                           TextWrapping="Wrap" Style="{StaticResource MicroText}"
                                           Text="Measured by the hardware, so nothing to define. Each names the truck signal that takes over the day the catalog has it (ADR-0016)." />
                                <ItemsControl ItemsSource="{Binding TabletSensors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceBrush}"
                                                    BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
                                                    CornerRadius="12" Padding="14,9,14,9" Margin="0,0,0,8" MinHeight="56">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Caption}"
                                                                   FontFamily="{StaticResource MonoFont}" FontSize="14"
                                                                   Foreground="{DynamicResource TextHighBrush}" />
                                                        <TextBlock Margin="0,3,0,0" Style="{StaticResource MicroText}"
                                                                   TextTrimming="CharacterEllipsis" Text="{Binding Detail}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                VerticalAlignment="Center" Margin="12,0,0,0">
                                                        <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                                                 Fill="{Binding Quality, Converter={StaticResource QualityBrushToken}}" />
                                                        <TextBlock Text="{Binding StatusText}" Margin="8,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   FontFamily="{StaticResource MonoFont}" FontSize="13"
                                                                   Foreground="{Binding Quality, Converter={StaticResource ValueBrushToken}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <TextBlock Margin="2,10,0,0" MaxWidth="620" HorizontalAlignment="Left"
                                       TextWrapping="Wrap" Style="{StaticResource MicroText}"
                                       Text="{Binding UserFilePath, StringFormat=Your signals are saved to {0} and laid over the shipped catalog at launch.}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- The editor: one definition, tested against the truck before it is saved. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="31,26,31,24" DataContext="{Binding Editor}">
                            <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Title}" />

                            <TextBlock Margin="2,10,0,0" MaxWidth="620" HorizontalAlignment="Left"
                                       TextWrapping="Wrap" Style="{StaticResource MicroText}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Text="{Binding Note}"
                                       Visibility="{Binding Note, Converter={StaticResource EmptyToCollapsed}}" />

                            <StackPanel Style="{StaticResource EditorField}" Margin="0,20,0,14">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="NAME" />
                                <TextBox Style="{StaticResource InputField}"
                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <StackPanel Style="{StaticResource EditorField}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="ID — WHAT CARDS SUBSCRIBE TO" />
                                    <TextBox Style="{StaticResource InputField}" Width="330"
                                             IsReadOnly="{Binding IsIdLocked}"
                                             Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource EditorField}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="GROUP" />
                                    <TextBox Style="{StaticResource InputField}" Width="230"
                                             Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- The request, and the TEST that asks the truck. -->
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,12,0,12" Text="REQUEST" />

                            <StackPanel Orientation="Horizontal">
                                <StackPanel Style="{StaticResource EditorField}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="BUS" />
                                    <Button Style="{StaticResource StageLauncherButton}" MinWidth="170"
                                            Command="{Binding ToggleBusCommand}">
                                        <TextBlock Text="{Binding BusLabel}" FontFamily="{StaticResource MonoFont}" FontSize="13" />
                                    </Button>
                                </StackPanel>
                                <StackPanel Style="{StaticResource EditorField}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="MODE (HEX)" />
                                    <TextBox Style="{StaticResource InputField}" Width="100" CharacterCasing="Upper"
                                             Text="{Binding ModeText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource EditorField}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="PID (HEX)" />
                                    <TextBox Style="{StaticResource InputField}" Width="120" CharacterCasing="Upper"
                                             Text="{Binding PidText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource EditorField}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text=" " />
                                    <Button Style="{StaticResource StageLauncherButton}" MinWidth="110"
                                            Command="{Binding TestCommand}">
                                        <TextBlock Text="TEST" FontFamily="{StaticResource MonoFont}" FontSize="13" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <Border Padding="14,10,14,10" CornerRadius="12" Margin="0,0,0,14"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
                                    Visibility="{Binding HasTested, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="15" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextHighBrush}">
                                        <Run Text="{Binding RequestText, Mode=OneWay}" Foreground="{DynamicResource TextLowBrush}" />
                                        <Run Text="→" Foreground="{DynamicResource TextLowBrush}" />
                                        <Run Text="{Binding TestRaw, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Style="{StaticResource MicroText}"
                                               Text="{Binding TestDecoded}" />
                                </StackPanel>
                            </Border>

                            <!-- How the bytes become a number. -->
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,6,0,12"
                                       Text="DECODE — VALUE = RAW × SCALE + OFFSET" />

                            <StackPanel Orientation="Horizontal">
                                <StackPanel Style="{StaticResource EditorField}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="FIRST BYTE" />
                                    <TextBox Style="{StaticResource InputField}" Width="110"
                                             Text="{Binding ByteOffsetText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource EditorField}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="LENGTH" />
                                    <ItemsControl ItemsSource="{Binding ByteLengths}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource OptionChipButton}" MinWidth="90" Margin="0,0,8,0"
                                                        Command="{Binding DataContext.SetByteLengthCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="{Binding Label}" FontFamily="{StaticResource MonoFont}" FontSize="13" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <StackPanel Style="{StaticResource EditorField}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="SIGN" />
                                    <Button Style="{StaticResource StageLauncherButton}" MinWidth="130"
                                            Command="{Binding ToggleSignedCommand}">
                                        <TextBlock Text="{Binding SignedLabel}" FontFamily="{StaticResource MonoFont}" FontSize="13" />
                                    </Button>
                                </StackPanel>
                                <StackPanel Style="{StaticResource EditorField}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="SCALE" />
                                    <TextBox Style="{StaticResource InputField}" Width="150"
                                             Text="{Binding ScaleText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource EditorField}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="OFFSET" />
                                    <TextBox Style="{StaticResource InputField}" Width="110"
                                             Text="{Binding OffsetText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource EditorField}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="UNIT" />
                                    <TextBox Style="{StaticResource InputField}" Width="100"
                                             Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- The guard and the cost. -->
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,6,0,12" Text="RANGE AND RATE" />

                            <StackPanel Orientation="Horizontal">
                                <StackPanel Style="{StaticResource EditorField}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="MIN" />
                                    <TextBox Style="{StaticResource InputField}" Width="130"
                                             Text="{Binding MinText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource EditorField}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="MAX" />
                                    <TextBox Style="{StaticResource InputField}" Width="130"
                                             Text="{Binding MaxText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource EditorField}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="RATE (HZ)" />
                                    <TextBox Style="{StaticResource InputField}" Width="110"
                                             Text="{Binding RateText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock MaxWidth="620" HorizontalAlignment="Left" TextWrapping="Wrap"
                                       Style="{StaticResource MicroText}"
                                       Text="A reading outside min/max is dropped, never shown: a wrong formula should read as a blank, not as a plausible number. The rate is what a card asks for by default — every signal shares one link." />

                            <TextBlock Margin="2,18,0,0" MaxWidth="620" HorizontalAlignment="Left" TextWrapping="Wrap"
                                       Style="{StaticResource EditorMessage}" Text="{Binding Message}" />

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Style="{StaticResource StageLauncherButton}" MinWidth="120"
                                        Command="{Binding SaveCommand}">
                                    <TextBlock Text="SAVE" FontFamily="{StaticResource MonoFont}" FontSize="13" />
                                </Button>
                                <Button Style="{StaticResource StageLauncherButton}" MinWidth="120"
                                        Command="{Binding CancelCommand}">
                                    <TextBlock Text="CANCEL" FontFamily="{StaticResource MonoFont}" FontSize="13" />
                                </Button>
                                <Button Style="{StaticResource StageLauncherButton}" MinWidth="120"
                                        Command="{Binding RemoveCommand}"
                                        Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding RemoveCaption}" FontFamily="{StaticResource MonoFont}" FontSize="13" />
                                </Button>
                            </StackPanel>

                            <TextBlock Margin="2,12,0,0" MaxWidth="620" HorizontalAlignment="Left" TextWrapping="Wrap"
                                       Style="{StaticResource MicroText}" Text="{Binding SaveDetail}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ── APPS (ADR-0024) ───────────────────────────────────────── -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsApps, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="31,26,31,24">
                    <TextBlock Style="{StaticResource CaptionText}" Text="STAGE APPS" />

                    <TextBlock Margin="2,10,0,0" MaxWidth="620" HorizontalAlignment="Left"
                               TextWrapping="Wrap" Style="{StaticResource MicroText}"
                               Text="Point the stage at a program already on this tablet — a browser, a player. It launches with your privileges and DashDeck does not sandbox it. This is a launcher, not an app store." />

                    <!-- The apps that ship with DashDeck: listed for reference, not editable —
                         their curated install paths are why they stay in code (ADR-0024). -->
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,22,0,0" Text="BUILT-IN" />

                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding BuiltInApps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                    <TextBlock Text="{Binding Name}" Width="120"
                                               FontFamily="{StaticResource MonoFont}" FontSize="14"
                                               Foreground="{DynamicResource TextMidBrush}" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource MicroText}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,22,0,0" Text="YOURS" />

                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,0"
                               Text="NAME · EXECUTABLE · ARGUMENTS (OPTIONAL)" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBox Style="{StaticResource InputField}" Width="150"
                                 CharacterCasing="Upper"
                                 Text="{Binding NewAppName, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Style="{StaticResource StageLauncherButton}"
                                Height="56" MinWidth="118" Margin="12,0,0,0"
                                Command="{Binding BrowseCommand}">
                            <TextBlock Text="BROWSE…" FontFamily="{StaticResource MonoFont}" FontSize="13" />
                        </Button>
                        <TextBox Style="{StaticResource InputField}" Width="200" Margin="12,0,0,0"
                                 Text="{Binding NewAppArguments, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Style="{StaticResource StageLauncherButton}"
                                Height="56" MinWidth="90" Margin="12,0,0,0"
                                Command="{Binding AddAppCommand}">
                            <TextBlock Text="ADD" FontFamily="{StaticResource MonoFont}" FontSize="13" />
                        </Button>
                    </StackPanel>

                    <!-- Whether this app plays audio and should keep going in the background when
                         you switch to a screen (ADR-0026). Off by default. -->
                    <Button Style="{StaticResource StageLauncherButton}"
                            Height="46" MinWidth="300" Margin="0,12,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding ToggleNewAppKeepPlayingCommand}">
                        <TextBlock Text="{Binding NewAppKeepPlayingLabel}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="13" />
                    </Button>

                    <TextBlock Margin="2,12,0,0" MaxWidth="620" HorizontalAlignment="Left"
                               TextWrapping="Wrap" Style="{StaticResource MicroText}"
                               Foreground="{Binding AppMessageBrush}"
                               Text="{Binding AppMessage}" />

                    <TextBlock Margin="2,4,0,0" MaxWidth="620" HorizontalAlignment="Left"
                               TextWrapping="Wrap" Style="{StaticResource MicroText}"
                               Text="{Binding NewAppPath, StringFormat=Chosen: {0}}"
                               Visibility="{Binding NewAppPath, Converter={StaticResource EmptyToCollapsed}}" />

                    <ItemsControl Margin="0,22,0,0" ItemsSource="{Binding Apps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
                                        CornerRadius="12" Padding="14,10,10,10" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="15"
                                                           Foreground="{DynamicResource TextHighBrush}" />
                                                <TextBlock Text="▶ keeps playing" Margin="10,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource MicroText}"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           Visibility="{Binding KeepPlaying, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                            <TextBlock Margin="0,3,0,0" Style="{StaticResource MicroText}"
                                                       TextTrimming="CharacterEllipsis" Text="{Binding Path}" />
                                        </StackPanel>

                                        <Button Grid.Column="1" Style="{StaticResource CardBadgeButton}"
                                                Content="✕" VerticalAlignment="Center"
                                                Command="{Binding DataContext.RemoveAppCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Margin="2,6,0,0" MaxWidth="620" HorizontalAlignment="Left"
                               TextWrapping="Wrap" Style="{StaticResource MicroText}"
                               Text="{Binding AppsPath, StringFormat=Saved to {0} — kept across updates.}" />
                </StackPanel>
            </ScrollViewer>

            <!-- ── DIAGNOSTICS ────────────────────────────────────────────── -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsDiagnostics, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="31,26,31,24">
                    <TextBlock Style="{StaticResource CaptionText}" Text="DIAGNOSTICS" />

                    <TextBlock Margin="2,14,0,0"
                               Style="{StaticResource StatusText}"
                               Foreground="{DynamicResource TextMidBrush}"
                               Text="{Binding DataContext.SourceLabel, RelativeSource={RelativeSource AncestorType=Window}}" />

                    <TextBlock Margin="2,6,0,0"
                               Style="{StaticResource MicroText}"
                               Text="{Binding DataContext.DriveLabel, RelativeSource={RelativeSource AncestorType=Window},
                                              StringFormat=Scripted drive: {0}}" />

                    <TextBlock Margin="2,6,0,0"
                               MaxWidth="620"
                               HorizontalAlignment="Left"
                               TextWrapping="Wrap"
                               Style="{StaticResource MicroText}"
                               Text="{Binding DataContext.RequestRateText, RelativeSource={RelativeSource AncestorType=Window},
                                              StringFormat={}{0} — measured adapter capability rather than load.}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
