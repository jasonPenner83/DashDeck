<UserControl x:Class="DashDeck.Host.Views.MapPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DashDeck.Host.Converters"
             Background="{DynamicResource CanvasBrush}">

    <UserControl.Resources>
        <conv:InverseBoolToVisibilityConverter x:Key="NotBoolToVis" />
    </UserControl.Resources>

    <!--
        The MAPS destination, standing in for ADR-0058's map until it is built.

        It is drawn at two quite different sizes — two bands below the stage (912 x 390) and all
        six (912 x 1170) — so nothing here is positioned against a fixed height: the picture
        stretches and the content stays centred in it. That is the whole point of the placeholder.
        When MapLibre arrives it replaces the Border's contents and the geometry around it is
        already settled.

        The one control left sits at the bottom, and deliberately: the bottom of this region is
        just above the nav strip at both sizes, which is the part of the screen that can be reached
        from the driver's seat. At the top it would be mid-screen in the small size and at arm's
        stretch in the large one.

        The size is changed by pressing MAPS in the nav again (ADR-0062's addendum), so there is no
        chip for it here — the hint on the right says so, because a gesture nothing announces is a
        control nobody finds.
    -->
    <DockPanel Margin="31,0,31,0">

        <!--
            Hidden while the map is on the stage. An occupant's controls belong in the overflow
            menu as actions, not drawn inside its own picture (ADR-0022) — so on the stage the way
            back is BRING IT BACK in that menu, and the hint would be wrong there anyway: there is
            no second size on the stage, and a press of MAPS brings the map back instead.
        -->
        <Grid DockPanel.Dock="Bottom" Margin="0,0,0,18"
              Visibility="{Binding IsOnStage, Converter={StaticResource NotBoolToVis}}">
            <Button HorizontalAlignment="Left"
                    Style="{StaticResource OptionChipButton}"
                    Content="TO THE STAGE"
                    Command="{Binding SendToStageCommand}" />

            <!-- Names the size the press would give you, not the one you are in. -->
            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                       Style="{StaticResource MicroText}"
                       Text="{Binding ResizeHint}" />
        </Grid>

        <Border CornerRadius="14"
                Margin="0,18,0,14"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource HairlineBrush}"
                BorderThickness="1">
            <!--
                Margins are kept tight because the small size is the binding constraint: the
                bottom third is 390 tall, the control row and the border's own margins take 116
                of it, and what is left has to hold all of this without the centred stack being
                clipped at both ends. The large size has three times the room and does not care.
            -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">

                <Path Data="M12,2 C8.1,2 5,5.1 5,9 C5,14.2 12,22 12,22 C12,22 19,14.2 19,9 C19,5.1 15.9,2 12,2 Z M12,11.5 A2.5,2.5 0 1 1 11.99,11.5 Z"
                      Stroke="{DynamicResource TextLowBrush}" StrokeThickness="1.5"
                      Width="44" Height="44" Stretch="Uniform" HorizontalAlignment="Center" />

                <TextBlock Margin="0,16,0,0"
                           HorizontalAlignment="Center"
                           FontFamily="{DynamicResource UiFont}"
                           FontSize="24"
                           Foreground="{DynamicResource TextLowBrush}"
                           Text="No map yet" />

                <!--
                    The position is the one real thing on this panel, and it is here because it is
                    the question that has to be answered before a map is worth drawing: the phone's
                    GPS is proven in the truck (Q38), and a map centred on nothing is worse than no
                    map. Same words as Settings' readout and the console probe, on purpose.
                -->
                <TextBlock Margin="0,22,0,0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           FontFamily="{DynamicResource MonoFont}"
                           FontSize="15"
                           Foreground="{DynamicResource TextMidBrush}"
                           Text="{Binding PositionText}" />

                <TextBlock Margin="0,6,0,0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Style="{StaticResource MicroText}"
                           Text="{Binding PositionDetail}" />

                <Border Height="1" Width="320" Margin="0,22,0,18"
                        Background="{DynamicResource HairlineBrush}" />

                <TextBlock HorizontalAlignment="Center"
                           TextAlignment="Center"
                           MaxWidth="560"
                           TextWrapping="Wrap"
                           Style="{StaticResource MicroText}"
                           Text="ADR-0058 · MAPLIBRE IN WEBVIEW2 · PMTILES ON THE TABLET · GRAPHHOPPER FOR ROUTES" />
            </StackPanel>
        </Border>
    </DockPanel>
</UserControl>
