<UserControl x:Class="DashDeck.Host.Views.MapPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DashDeck.Host.Converters"
             Background="{DynamicResource CanvasBrush}">

    <UserControl.Resources>
        <conv:InverseBoolToVisibilityConverter x:Key="NotBoolToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <!--
        The MAPS destination: MapLibre on tiles fetched as you drive (ADR-0063), in whichever of
        its three placements is current (ADR-0062).

        It is drawn at two quite different sizes — two bands below the stage (912 x 390) and all
        six (912 x 1170) — so nothing here is positioned against a fixed height.

        The one control left sits at the bottom, and deliberately: the bottom of this region is
        just above the nav strip at both sizes, which is the part of the screen that can be reached
        from the driver's seat. The size is changed by pressing MAPS in the nav again (ADR-0062's
        addendum), so there is no chip for it — the hint on the right says so.

        **The map and the placeholder never overlap.** A WebView2 is a child window and WPF cannot
        draw over it (ADR-0021), so the two swap rather than stack: the dash draws the states where
        there is no page at all, and the page draws its own "loading" over its own canvas.
    -->
    <DockPanel Margin="31,0,31,0">

        <!--
            Hidden while the map is on the stage. An occupant's controls belong in the overflow
            menu as actions, not drawn inside its own picture (ADR-0022) — so on the stage the way
            back is BRING THE MAP BACK in that menu, and RECENTRE is an action there too.
        -->
        <Grid DockPanel.Dock="Bottom" Margin="0,0,0,18"
              Visibility="{Binding IsOnStage, Converter={StaticResource NotBoolToVis}}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Style="{StaticResource OptionChipButton}"
                        Content="TO THE STAGE"
                        Command="{Binding SendToStageCommand}" />

                <!-- Only after a pan has taken the map off the vehicle. A permanent RECENTRE
                     would be a control that does nothing most of the time. -->
                <Button Style="{StaticResource OptionChipButton}"
                        Margin="12,0,0,0"
                        Content="RECENTRE"
                        Command="{Binding RecentreCommand}"
                        Visibility="{Binding IsRecentreOffered, Converter={StaticResource BoolToVis}}" />

                <!-- Offered only when it failed, which on this connection means the signal came
                     and went rather than anything being wrong with the dash. -->
                <Button Style="{StaticResource OptionChipButton}"
                        Margin="12,0,0,0"
                        Content="TRY AGAIN"
                        Command="{Binding RetryCommand}"
                        Visibility="{Binding HasFailed, Converter={StaticResource BoolToVis}}" />
            </StackPanel>

            <!-- Names the size the press would give you, not the one you are in. -->
            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                       Style="{StaticResource MicroText}"
                       Text="{Binding ResizeHint}" />
        </Grid>

        <Border CornerRadius="14"
                Margin="0,18,0,14"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource HairlineBrush}"
                BorderThickness="1"
                ClipToBounds="True">
            <Grid>
                <!-- The map. Filled in by the code-behind, which owns the browser control for as
                     long as this panel is on screen. Shown whenever there is one at all: while it
                     loads, the page itself says so over its own dark canvas. -->
                <ContentPresenter x:Name="Surface"
                                  Visibility="{Binding WantsSurface, Converter={StaticResource BoolToVis}}" />

                <!-- No map, and why. The three states with no page: GPS off, no fix yet, and a
                     load that failed. -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16"
                            Visibility="{Binding WantsSurface, Converter={StaticResource NotBoolToVis}}">

                    <Path Data="M12,2 C8.1,2 5,5.1 5,9 C5,14.2 12,22 12,22 C12,22 19,14.2 19,9 C19,5.1 15.9,2 12,2 Z M12,11.5 A2.5,2.5 0 1 1 11.99,11.5 Z"
                          Stroke="{DynamicResource TextLowBrush}" StrokeThickness="1.5"
                          Width="44" Height="44" Stretch="Uniform" HorizontalAlignment="Center" />

                    <TextBlock Margin="0,16,0,0"
                               HorizontalAlignment="Center"
                               FontFamily="{DynamicResource UiFont}"
                               FontSize="24"
                               Foreground="{DynamicResource TextLowBrush}"
                               Text="{Binding PlaceholderTitle}" />

                    <TextBlock Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               MaxWidth="620"
                               TextWrapping="Wrap"
                               Style="{StaticResource MicroText}"
                               Text="{Binding PlaceholderDetail}" />

                    <!--
                        The position, in the same words Settings' readout and the console probe
                        use. It stays on the no-map states because it is what says whether the
                        problem is the position or the tiles — two failures that look identical
                        otherwise.
                    -->
                    <Border Height="1" Width="320" Margin="0,22,0,16"
                            Background="{DynamicResource HairlineBrush}" />

                    <TextBlock HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontFamily="{DynamicResource MonoFont}"
                               FontSize="14"
                               Foreground="{DynamicResource TextMidBrush}"
                               Text="{Binding PositionText}" />

                    <TextBlock Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Style="{StaticResource MicroText}"
                               Text="{Binding PositionDetail}" />
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
