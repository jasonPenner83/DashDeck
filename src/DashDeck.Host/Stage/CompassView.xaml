<UserControl x:Class="DashDeck.Host.Stage.CompassView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- A small readout: caption above, value and unit below. -->
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextHighBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="31,8,31,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Heading. -->
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <Grid Width="320" Height="320" HorizontalAlignment="Center">
                <Ellipse Width="300" Height="300"
                         Stroke="{DynamicResource HairlineStrongBrush}"
                         StrokeThickness="1" />

                <!--
                    Ticks and letters are built in the code-behind rather than written out
                    here: seventy-two of them by hand is unreadable markup and unmaintainable
                    geometry, and this is the first thing on the dash that is genuinely drawn
                    rather than laid out (F5).
                -->
                <Canvas x:Name="Rose" Width="320" Height="320" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform>
                        <RotateTransform Angle="{Binding RoseAngle}" />
                    </Canvas.RenderTransform>
                </Canvas>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="62"
                               FontWeight="Bold"
                               Foreground="{Binding HeadingQuality, Converter={StaticResource ValueBrushToken}}"
                               Text="{Binding HeadingText}" />
                    <TextBlock HorizontalAlignment="Center"
                               Margin="0,-6,0,0"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="24"
                               Foreground="{DynamicResource AccentBrush}"
                               Text="{Binding CardinalText}" />
                    
                </StackPanel>

                <!-- The fixed marker: which way the truck is pointing. -->
                <Path VerticalAlignment="Top" HorizontalAlignment="Center"
                      Margin="0,-2,0,0"
                      Data="M0,0 L16,0 L8,13 Z"
                      Fill="{DynamicResource AccentBrush}" />
            </Grid>

            <TextBlock HorizontalAlignment="Center"
                       Margin="0,2,0,0"
                       FontFamily="{StaticResource MonoFont}"
                       FontSize="12"
                       Foreground="{Binding HeadingQuality, Converter={StaticResource QualityBrushToken}}"
                       Text="{Binding HeadingSource}" />
        </StackPanel>

        <!-- G meter. -->
        <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <Grid Width="240" Height="240" HorizontalAlignment="Center">
                <Canvas x:Name="GGrid" Width="240" Height="240" />

                <!-- The ball. Moves in the direction the driver is pushed. -->
                <Ellipse x:Name="Ball" Width="26" Height="26"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Fill="{Binding MotionQuality, Converter={StaticResource QualityBrushToken}}"
                         Visibility="{Binding IsLevelled, Converter={StaticResource BoolToVis}}">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="BallShift" />
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- Not levelled: say so, rather than parking the ball at nothing. -->
                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Width="180"
                           Style="{StaticResource MicroText}"
                           Visibility="{Binding NeedsLevelling, Converter={StaticResource BoolToVis}}"
                           Text="Park level, then LEVEL — the mount angle is not the truck's" />
            </Grid>

            <Grid Margin="0,2,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Bottom" Text="G " />
                    <TextBlock Style="{StaticResource MetricValue}" FontSize="26" Text="{Binding GText}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Bottom" Text="PEAK " />
                    <TextBlock Style="{StaticResource MetricValue}"
                               FontSize="26"
                               Foreground="{DynamicResource TextMidBrush}"
                               Text="{Binding PeakText}" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Attitude, and the two numbers that belong beside a heading. -->
        <Grid Grid.Column="4" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="22" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0">
                <TextBlock Style="{StaticResource CaptionText}" Text="PITCH" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource MetricValue}"
                               Foreground="{Binding AttitudeQuality, Converter={StaticResource ValueBrushToken}}"
                               Text="{Binding PitchText}" />
                    <TextBlock Style="{StaticResource UnitText}" Margin="4,0,0,5" VerticalAlignment="Bottom" Text="°" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="1">
                <TextBlock Style="{StaticResource CaptionText}" Text="ROLL" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource MetricValue}"
                               Foreground="{Binding AttitudeQuality, Converter={StaticResource ValueBrushToken}}"
                               Text="{Binding RollText}" />
                    <TextBlock Style="{StaticResource UnitText}" Margin="4,0,0,5" VerticalAlignment="Bottom" Text="°" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0">
                <TextBlock Style="{StaticResource CaptionText}" Text="SPEED" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource MetricValue}"
                               Foreground="{Binding Speed.Quality, Converter={StaticResource ValueBrushToken}}"
                               Text="{Binding Speed.Text}" />
                    <TextBlock Style="{StaticResource UnitText}" Margin="4,0,0,5" VerticalAlignment="Bottom"
                               Text="{Binding Speed.Unit}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="1">
                <TextBlock Style="{StaticResource CaptionText}" Text="OUTSIDE" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource MetricValue}"
                               Foreground="{Binding Outside.Quality, Converter={StaticResource ValueBrushToken}}"
                               Text="{Binding Outside.Text}" />
                    <TextBlock Style="{StaticResource UnitText}" Margin="4,0,0,5" VerticalAlignment="Bottom"
                               Text="{Binding Outside.Unit}" />
                </StackPanel>
            </StackPanel>

            <!-- Levelling moved to the stage action bar: a control used once, parked, does
                 not belong among numbers read constantly. -->
        </Grid>
    </Grid>
</UserControl>
