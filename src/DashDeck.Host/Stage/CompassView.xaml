<UserControl x:Class="DashDeck.Host.Stage.CompassView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="31,10,31,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="250" />
        </Grid.ColumnDefinitions>

        <!-- The rose. -->
        <Grid Grid.Column="0" Width="380" Height="380" HorizontalAlignment="Center" VerticalAlignment="Center">

            <Ellipse Width="356" Height="356"
                     Stroke="{DynamicResource HairlineStrongBrush}"
                     StrokeThickness="1" />

            <!--
                Ticks and letters are built in the code-behind rather than written out here:
                seventy-two of them by hand is unreadable markup and unmaintainable geometry,
                and this is the first thing on the dash that is genuinely drawn rather than
                laid out (F5).
            -->
            <Canvas x:Name="Rose" Width="380" Height="380" RenderTransformOrigin="0.5,0.5">
                <Canvas.RenderTransform>
                    <RotateTransform Angle="{Binding RoseAngle}" />
                </Canvas.RenderTransform>
            </Canvas>

            <!-- The heading you are on, under the fixed marker. The card turns; this does not. -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock HorizontalAlignment="Center"
                           FontFamily="{StaticResource UiFont}"
                           FontSize="76"
                           FontWeight="Bold"
                           Foreground="{Binding Quality, Converter={StaticResource ValueBrushToken}}"
                           Text="{Binding HeadingText}" />
                <TextBlock HorizontalAlignment="Center"
                           Margin="0,-6,0,0"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="28"
                           Foreground="{DynamicResource AccentBrush}"
                           Text="{Binding CardinalText}" />
            </StackPanel>

            <!-- The fixed marker: which way the truck is pointing. -->
            <Path VerticalAlignment="Top" HorizontalAlignment="Center"
                  Margin="0,-2,0,0"
                  Data="M0,0 L18,0 L9,15 Z"
                  Fill="{DynamicResource AccentBrush}" />
        </Grid>

        <!-- Where it came from, and two things worth knowing beside a bearing. -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center">

            <TextBlock Style="{StaticResource CaptionText}" Text="HEADING FROM" />
            <TextBlock Margin="0,6,0,0"
                       FontFamily="{StaticResource MonoFont}"
                       FontSize="15"
                       TextWrapping="Wrap"
                       Foreground="{Binding Quality, Converter={StaticResource QualityBrushToken}}"
                       Text="{Binding SourceText}" />

            <Border Margin="0,8,0,0"
                    HorizontalAlignment="Left"
                    CornerRadius="999"
                    Padding="9,4,9,4"
                    BorderThickness="1"
                    BorderBrush="{Binding Quality, Converter={StaticResource QualityBrushToken}}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                             Fill="{Binding Quality, Converter={StaticResource QualityBrushToken}}" />
                    <TextBlock Margin="6,0,0,0"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{Binding Quality, Converter={StaticResource QualityBrushToken}}"
                               Text="{Binding Quality, Converter={StaticResource QualityLabelToken}}" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource CaptionText}" Margin="0,28,0,0" Text="SPEED" />
            <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{StaticResource UiFont}"
                           FontSize="42"
                           FontWeight="Bold"
                           Foreground="{Binding Speed.Quality, Converter={StaticResource ValueBrushToken}}"
                           Text="{Binding Speed.Text}" />
                <TextBlock Style="{StaticResource UnitText}"
                           Margin="8,0,0,7"
                           VerticalAlignment="Bottom"
                           Text="{Binding Speed.Unit}" />
            </StackPanel>

            <TextBlock Style="{StaticResource CaptionText}" Margin="0,18,0,0" Text="OUTSIDE" />
            <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{StaticResource UiFont}"
                           FontSize="42"
                           FontWeight="Bold"
                           Foreground="{Binding Outside.Quality, Converter={StaticResource ValueBrushToken}}"
                           Text="{Binding Outside.Text}" />
                <TextBlock Style="{StaticResource UnitText}"
                           Margin="8,0,0,7"
                           VerticalAlignment="Bottom"
                           Text="{Binding Outside.Unit}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
