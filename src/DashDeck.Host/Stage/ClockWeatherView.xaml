<UserControl x:Class="DashDeck.Host.Stage.ClockWeatherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DashDeck.Host.Converters"
             Background="{DynamicResource CanvasBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:WeatherIconConverter x:Key="WeatherIcon" />
    </UserControl.Resources>

    <Grid Margin="40,0,40,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Time on the left, conditions on the right. The clock is the biggest thing on
             the dash because it is the thing most often glanced at. -->
        <Grid Grid.Row="0" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="{Binding TimeText}"
                           FontFamily="{DynamicResource UiFont}"
                           FontSize="150"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextHighBrush}"
                           LineHeight="150"
                           LineStackingStrategy="BlockLineHeight" />
                <TextBlock Text="{Binding DateText}"
                           Margin="6,10,0,0"
                           FontFamily="{DynamicResource UiFont}"
                           FontSize="22"
                           Foreground="{DynamicResource TextMidBrush}" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- The condition as an icon, read at a glance and across the cab. Themed,
                     because it is a Path filled with a theme brush rather than a baked image. -->
                <Path Data="{Binding ConditionCode, Converter={StaticResource WeatherIcon}}"
                      Fill="{DynamicResource TextHighBrush}"
                      Stretch="Uniform"
                      Width="96" Height="96"
                      HorizontalAlignment="Right"
                      Margin="0,0,0,4"
                      Visibility="{Binding HasWeather, Converter={StaticResource BoolToVis}}" />

                <!-- One TextBlock with two runs, not two blocks side by side: runs share a
                     baseline, so the degree sign sits against the digits instead of
                     floating above them. -->
                <TextBlock HorizontalAlignment="Right"
                           FontFamily="{DynamicResource UiFont}"
                           Foreground="{DynamicResource TextHighBrush}">
                    <Run Text="{Binding TemperatureText, Mode=OneWay}"
                         FontSize="86"
                         FontWeight="Bold" />
                    <Run Text="°"
                         FontSize="46"
                         Foreground="{DynamicResource TextMidBrush}" />
                </TextBlock>

                <TextBlock Text="{Binding ConditionText}"
                           HorizontalAlignment="Right"
                           FontFamily="{DynamicResource UiFont}"
                           FontSize="24"
                           Foreground="{DynamicResource TextMidBrush}" />

                <TextBlock Text="{Binding FeelsLikeText}"
                           HorizontalAlignment="Right"
                           Margin="0,6,0,0"
                           Style="{StaticResource CaptionText}" />

                <!-- Weather says how much it can be trusted, like every other number here. -->
                <TextBlock Text="{Binding WeatherStatus}"
                           HorizontalAlignment="Right"
                           Margin="0,10,0,0"
                           Style="{StaticResource MicroText}" />
            </StackPanel>
        </Grid>

        <!-- The forecast, each day with its condition as an icon. -->
        <ItemsControl Grid.Row="1"
                      Margin="0,0,0,36"
                      ItemsSource="{Binding Forecast}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource HairlineBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Margin="0,0,16,0"
                            Padding="20,16,20,16">
                        <StackPanel>
                            <DockPanel>
                                <Path DockPanel.Dock="Right"
                                      Data="{Binding Code, Converter={StaticResource WeatherIcon}}"
                                      Fill="{DynamicResource TextMidBrush}"
                                      Stretch="Uniform"
                                      Width="30" Height="30"
                                      VerticalAlignment="Center"
                                      ToolTip="{Binding Condition}" />
                                <TextBlock Text="{Binding Day}"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource CaptionText}" />
                            </DockPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="{Binding High}"
                                           FontFamily="{DynamicResource UiFont}"
                                           FontSize="34"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextHighBrush}" />
                                <TextBlock Text="{Binding Low}"
                                           Margin="12,0,0,4"
                                           VerticalAlignment="Bottom"
                                           FontFamily="{DynamicResource UiFont}"
                                           FontSize="22"
                                           Foreground="{DynamicResource TextLowBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
