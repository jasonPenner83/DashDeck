<UserControl x:Class="DashDeck.Host.Stage.PhoneLinkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <!--
            The phone's screen, decoded into a bitmap in WPF's own tree (ADR-0057): the stage clips
            it and the three-dot menu draws over it. Scaled uniformly and centred; touch is mapped
            to the picture as drawn, so a phone that renders its own size still lines up.
        -->
        <Border Background="Black"
                Visibility="{Binding IsProjecting, Converter={StaticResource BoolToVis}}">
            <Image x:Name="Screen"
                   Source="{Binding Picture}"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="LowQuality" />
        </Border>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="640"
                    Visibility="{Binding IsProjecting, Converter={StaticResource NotBoolToVisToken}}">
            <TextBlock HorizontalAlignment="Center"
                       FontFamily="{DynamicResource UiFont}"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextHighBrush}"
                       Text="{Binding Headline}" />

            <TextBlock HorizontalAlignment="Center"
                       Margin="0,14,0,0"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Style="{StaticResource StatusText}"
                       Foreground="{DynamicResource TextMidBrush}"
                       Text="{Binding Detail}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                <TextBlock Style="{StaticResource MicroText}" Text="{Binding TransportText}" />
                <TextBlock Style="{StaticResource MicroText}" Margin="16,0,0,0" Text="{Binding FramesText}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
